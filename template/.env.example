# ==============================================================================
# SITES FACILES MALI — CONFIGURATION D'ENVIRONNEMENT (.env.example)
# ==============================================================================
# Copier ce fichier sous le nom '.env' dans votre site et adapter les valeurs.

# Secret d'administration pour la connexion au CMS Inline (/admin et API)
CMS_ADMIN_SECRET=

# Activation du flux d'automatisation Git lors de la publication
# Values: true | false
CMS_GIT_ENABLED=false

# Branche Git sur laquelle pousser les commits de publication automatique
# OBLIGATOIRE si CMS_GIT_ENABLED=true. Si non définie, le commit/push est refusé.
# Exemples : prod, main, master
# CMS_GIT_BRANCH=prod
