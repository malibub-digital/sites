---
import BaseLayout from "@malihub/sites-core/layouts/BaseLayout.astro";
import Header from "@malihub/sites-core/components/Header.astro";
import Footer from "@malihub/sites-core/components/Footer.astro";
import siteConfig from "../../site.config.json";
---

<BaseLayout
  title={`Guide & Documentation — ${siteConfig.title}`}
  description="Guide complet pour comprendre la mission de Sites Faciles, utiliser le moteur CMS et déployer des sites conformes au DSML."
>
  <Header
    slot="header"
    title={siteConfig.title}
    institution={siteConfig.institution}
    logoUrl={siteConfig.logoUrl}
    navItems={siteConfig.navigation?.links}
  />

  <main
    id="main-content"
    class="py-12 bg-[var(--ml-color-bogolan-kaolin)]/50 min-h-screen"
  >
    <div class="ml-container max-w-4xl mx-auto px-4">
      <nav class="text-xs text-[var(--ml-color-neutral-500)] mb-6 flex gap-2">
        <a href="/" class="hover:underline text-[var(--ml-color-neutral-600)]"
          >Accueil</a
        >
        <span>/</span>
        <span class="text-[var(--ml-color-neutral-800)] font-semibold"
          >Guide & Documentation</span
        >
      </nav>

      <!-- Banner Header -->
      <div
        class="relative rounded-3xl overflow-hidden mb-12 bg-gradient-to-r from-[var(--ml-color-river-800)] via-[var(--ml-color-indigo-700)] to-[var(--ml-color-indigo-900)] text-white p-8 md:p-12 shadow-xl border-2 border-[var(--ml-color-mandingue-orange)]/50"
      >
        <div
          class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-[var(--ml-color-mandingue-500)] via-transparent to-transparent pointer-events-none"
        >
        </div>
        <div class="relative z-10">
          <span
            class="inline-flex items-center gap-1.5 bg-white/15 text-[var(--ml-color-mandingue-100)] text-xs font-bold px-3.5 py-1 rounded-full uppercase tracking-wider mb-4 border border-white/20 backdrop-blur-md"
          >
            Documentation Officielle
          </span>
          <h1
            class="text-3xl md:text-4xl font-black font-title tracking-tight text-[var(--ml-color-mandingue-100)] mb-3 drop-shadow-md"
          >
            Guide d'Utilisation & Prise en Main
          </h1>
          <p
            class="text-sm md:text-base text-white/95 leading-relaxed font-medium"
          >
            Découvrez comment Sites Faciles Mali simplifie la création,
            l'édition et le déploiement de portails institutionnels conformes à
            la charte DSML.
          </p>
        </div>
      </div>

      <!-- Content Sections -->
      <div class="space-y-10">
        <!-- 1. Vocation du projet -->
        <section
          class="bg-white p-8 rounded-3xl border border-[var(--ml-color-neutral-200)] shadow-sm"
        >
          <div class="flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-full bg-[var(--ml-color-mandingue-50)] text-[var(--ml-color-mandingue-700)] flex items-center justify-center font-bold text-sm border border-[var(--ml-color-mandingue-200)]"
              >1</span
            >
            <h2
              class="text-xl font-extrabold text-[var(--ml-color-neutral-900)] font-title m-0"
            >
              Vocation & Mission de Sites Faciles
            </h2>
          </div>
          <p
            class="text-sm text-[var(--ml-color-neutral-700)] leading-relaxed mb-4"
          >
            <strong>Sites Faciles Mali</strong> a été conçu pour résoudre un défi
            récurrent des administrations publiques : la création rapide de sites
            web modernes, sécurisés et visuellement cohérents sans réinventer la roue.
          </p>
          <ul
            class="space-y-2 text-xs text-[var(--ml-color-neutral-700)] list-disc pl-5"
          >
            <li>
              <strong>Conformité DSML garantie :</strong> L'intégration native du
              Design System Mali assure le respect des couleurs, typographies et pictogrammes
              officiels.
            </li>
            <li>
              <strong>Édition sans code :</strong> Les agents et rédacteurs peuvent
              modifier les contenus directement depuis l'interface grâce au CMS inline.
            </li>
            <li>
              <strong>Déploiement Git automatisé :</strong> Publication des contenus
              en temps réel via des commits Git automatiques sur Dokploy/GitHub.
            </li>
          </ul>
        </section>

        <!-- 2. Guide d'édition CMS -->
        <section
          class="bg-white p-8 rounded-3xl border border-[var(--ml-color-neutral-200)] shadow-sm"
        >
          <div class="flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-full bg-[var(--ml-color-river-50)] text-[var(--ml-color-river-700)] flex items-center justify-center font-bold text-sm border border-[var(--ml-color-river-200)]"
              >2</span
            >
            <h2
              class="text-xl font-extrabold text-[var(--ml-color-neutral-900)] font-title m-0"
            >
              Mode Édition & CMS Inline
            </h2>
          </div>
          <p
            class="text-sm text-[var(--ml-color-neutral-700)] leading-relaxed mb-4"
          >
            Le mode édition permet d'éditer le texte directement sur les pages
            sans passer par un tableau de bord complexe.
          </p>
          <ol
            class="space-y-3 text-xs text-[var(--ml-color-neutral-700)] list-decimal pl-5"
          >
            <li>
              Rendez-vous sur la page d'administration <code>/admin</code> pour déverrouiller
              l'accès.
            </li>
            <li>
              Activez l'interrupteur <strong>"Mode Édition"</strong> dans le bandeau
              supérieur d'administration.
            </li>
            <li>
              Survolez n'importe quel élément entouré d'un pointillé bleu pour
              cliquer et modifier son contenu.
            </li>
            <li>
              Cliquez sur <strong>"Publier les modifications"</strong> dans le bandeau
              supérieur pour valider et enregistrer.
            </li>
          </ol>
        </section>

        <!-- 3. Configuration d'une nouvelle institution -->
        <section
          class="bg-white p-8 rounded-3xl border border-[var(--ml-color-neutral-200)] shadow-sm"
        >
          <div class="flex items-center gap-3 mb-4">
            <span
              class="w-8 h-8 rounded-full bg-[var(--ml-color-green-50)] text-[var(--ml-color-green-700)] flex items-center justify-center font-bold text-sm border border-[var(--ml-color-green-200)]"
              >3</span
            >
            <h2
              class="text-xl font-extrabold text-[var(--ml-color-neutral-900)] font-title m-0"
            >
              Déployer pour une nouvelle Institution
            </h2>
          </div>
          <p
            class="text-sm text-[var(--ml-color-neutral-700)] leading-relaxed mb-4"
          >
            Pour réutiliser ce template pour un ministère, un gouvernorat ou une
            agence publique :
          </p>
          <div
            class="bg-[var(--ml-color-neutral-900)] text-white p-4 rounded-xl text-xs overflow-x-auto font-mono mb-4"
          >
            <div>// Éditer site.config.json</div>
            <div>&#123;</div>
            <div class="pl-4">
              "title": "Ministère de la Transition Numérique",
            </div>
            <div class="pl-4">"institution": "RÉPUBLIQUE DU MALI",</div>
            <div class="pl-4">"logoUrl": "/images/logo-mali.svg",</div>
            <div class="pl-4">
              "contact": &#123; "email": "contact@malihub.digital" &#125;
            </div>
            <div>&#125;</div>
          </div>
          <p class="text-xs text-[var(--ml-color-neutral-600)]">
            Toutes les pages du site, les menus de navigation et le pied de page
            s'adapteront automatiquement.
          </p>
        </section>

        <!-- Call to Action -->
        <div
          class="bg-gradient-to-r from-[var(--ml-color-river-800)] to-[var(--ml-color-indigo-900)] p-8 rounded-3xl text-white flex flex-wrap items-center justify-between gap-6 shadow-lg"
        >
          <div>
            <h3 class="text-lg font-black font-title text-white m-0 mb-1">
              Prêt à explorer la bibliothèque ?
            </h3>
            <p class="text-xs text-white/80 m-0">
              Découvrez l'ensemble des palettes et des éléments UI certifiés
              DSML.
            </p>
          </div>
          <a
            href="/composants"
            class="px-6 py-3 bg-[var(--ml-color-mandingue-orange)] hover:bg-[var(--ml-color-mandingue-700)] text-white font-bold rounded-xl text-xs transition-all no-underline inline-flex items-center gap-2"
          >
            <span>Bibliothèque de Composants</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer
    slot="footer"
    institution={siteConfig.institution}
    contact={siteConfig.contact}
    footerLinks={siteConfig.footerLinks}
  />
</BaseLayout>
