---
import BaseLayout from '@malihub/sites-core/layouts/BaseLayout.astro';
import Header from '@malihub/sites-core/components/Header.astro';
import Footer from '@malihub/sites-core/components/Footer.astro';
import Hero from '@malihub/sites-core/components/Hero.astro';
import ServiceCard from '@malihub/sites-core/components/ServiceCard.astro';
import siteConfig from '../../site.config.json';
import homeData from '../data/pages/home.json';

const featuredServices = [
  {
    title: 'Carte d\'Immatriculation Consulaire',
    summary: 'Exemple de fiche de démarche pour les citoyens maliens résidant à l\'étranger.',
    category: 'Identité & Consulat (Démo)',
    cost: '15 € / 10 000 FCFA',
    processingTime: '48 heures',
    href: '/services/carte-consulaire',
    badgeText: 'Exemple Populaire',
    variant: 'featured' as const
  },
  {
    title: 'Passeport Biométrique Malien',
    summary: 'Modèle de procédure de prise d\'empreintes et pièces requises.',
    category: 'Voyage & Identité (Démo)',
    cost: '85 000 FCFA',
    processingTime: '2 à 3 semaines',
    href: '/services/passeport',
    badgeText: 'Modèle DSML',
    variant: 'accent' as const
  },
  {
    title: 'Accompagnement Emploi & Stage APEJ',
    summary: 'Modèle d\'intégration pour les programmes de jeunesse et d\'emploi.',
    category: 'Emploi & Jeunesse (Démo)',
    cost: 'Gratuit',
    processingTime: 'Immédiat en ligne',
    href: '/services/emploi-apej',
    badgeText: 'Exemple APEJ',
    variant: 'indigo' as const
  }
];

const newsPreview = [
  {
    title: 'Mise en place de la permanence consulaire du week-end',
    date: '28 Juillet 2026',
    category: 'Consulat (Démo)',
    excerpt: 'Exemple d’actualité officielle intégrant le composant carte et les badgets de catégorie.',
    href: '/actualites'
  },
  {
    title: 'Lancement du nouveau guichet d\'orientation professionnelle APEJ',
    date: '15 Juillet 2026',
    category: 'Emploi (Démo)',
    excerpt: 'Exemple d’annonce pour les opportunités et événements des services publics.',
    href: '/actualites'
  }
];
---

<BaseLayout title={siteConfig.title} description={siteConfig.description} emergencyNotice={siteConfig.emergencyNotice}>
  <Header
    slot="header"
    title={siteConfig.title}
    institution={siteConfig.institution}
    logoUrl={siteConfig.logoUrl}
    navItems={siteConfig.navigation?.links}
  />

  <Hero
    title={homeData.hero.title}
    subtitle={homeData.hero.subtitle}
    badge={homeData.hero.badge}
    primaryAction={homeData.hero.primaryAction}
    secondaryAction={homeData.hero.secondaryAction}
    quickLinks={homeData.quickLinks}
  />

  <!-- SECTION 1: VALEUR AJOUTÉE & POURQUOI SITES FACILES -->
  <section class="py-16 bg-white border-b border-[var(--ml-color-neutral-200)]">
    <div class="ml-container max-w-6xl mx-auto px-4">
      <div class="text-center mb-12 max-w-3xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-wider text-[var(--ml-color-mandingue-700)] bg-[var(--ml-color-mandingue-50)] px-3.5 py-1 rounded-full mb-3 inline-block border border-[var(--ml-color-mandingue-100)]" data-cms-bind="src/data/pages/home.json::whyUs.badge">
          {homeData.whyUs.badge}
        </span>
        <h2 class="text-3xl font-black text-[var(--ml-color-neutral-900)] font-title" data-cms-bind="src/data/pages/home.json::whyUs.title">{homeData.whyUs.title}</h2>
        <p class="text-[var(--ml-color-neutral-600)] mt-2 text-sm leading-relaxed" data-cms-bind="src/data/pages/home.json::whyUs.subtitle">
          {homeData.whyUs.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="p-8 rounded-3xl bg-[var(--ml-color-river-50)]/60 border border-[var(--ml-color-river-200)] shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-[var(--ml-color-river-600)] text-white flex items-center justify-center mb-5 text-xl font-bold shadow-md">
              🎨
            </div>
            <h3 class="text-lg font-extrabold text-[var(--ml-color-neutral-900)] font-title mb-2">Conformité DSML Garantie</h3>
            <p class="text-xs text-[var(--ml-color-neutral-600)] leading-relaxed mb-4">
              Profitez d'un nuancier officiel (Orange Mandingue, Vert République, Bleu Fleuve Niger), de typographies certifiées et d'icônes prêtes à l'emploi.
            </p>
          </div>
          <a href="/composants" class="text-xs font-bold text-[var(--ml-color-river-700)] hover:underline inline-flex items-center gap-1 no-underline">
            <span>Explorer les composants</span>
            <span>&rarr;</span>
          </a>
        </div>

        <div class="p-8 rounded-3xl bg-[var(--ml-color-mandingue-50)]/60 border border-[var(--ml-color-mandingue-200)] shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-[var(--ml-color-mandingue-orange)] text-white flex items-center justify-center mb-5 text-xl font-bold shadow-md">
              ✏️
            </div>
            <h3 class="text-lg font-extrabold text-[var(--ml-color-neutral-900)] font-title mb-2">CMS Inline en Temps Réel</h3>
            <p class="text-xs text-[var(--ml-color-neutral-600)] leading-relaxed mb-4">
              Modifiez directement les textes, liens et images sur la page comme un traitement de texte. Aucune formation technique requise.
            </p>
          </div>
          <a href="/guide" class="text-xs font-bold text-[var(--ml-color-mandingue-700)] hover:underline inline-flex items-center gap-1 no-underline">
            <span>Voir le mode d'emploi</span>
            <span>&rarr;</span>
          </a>
        </div>

        <div class="p-8 rounded-3xl bg-[var(--ml-color-indigo-50)]/60 border border-[var(--ml-color-indigo-200)] shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-[var(--ml-color-indigo-600)] text-white flex items-center justify-center mb-5 text-xl font-bold shadow-md">
              🚀
            </div>
            <h3 class="text-lg font-extrabold text-[var(--ml-color-neutral-900)] font-title mb-2">Déploiement Continu Git</h3>
            <p class="text-xs text-[var(--ml-color-neutral-600)] leading-relaxed mb-4">
              Chaque validation génère automatiquement des commits Git sur GitHub / Dokploy pour un déploiement instantané en zéro-downtime.
            </p>
          </div>
          <a href="/guide#institution" class="text-xs font-bold text-[var(--ml-color-indigo-700)] hover:underline inline-flex items-center gap-1 no-underline">
            <span>Guide de déploiement</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 2: SHOWCASE DES COMPOSANTS DSML -->
  <section class="py-16 bg-[var(--ml-color-river-50)]/30 border-b border-[var(--ml-color-neutral-200)]">
    <div class="ml-container max-w-6xl mx-auto px-4">
      <div class="flex flex-wrap justify-between items-end mb-10 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--ml-color-river-700)] bg-[var(--ml-color-river-100)] px-3.5 py-1 rounded-full mb-2 inline-block border border-[var(--ml-color-river-200)]">
            Design System Mali
          </span>
          <h2 class="text-2xl md:text-3xl font-black text-[var(--ml-color-neutral-900)] font-title m-0">Aperçu de la Charte & des Composants</h2>
        </div>
        <a href="/composants" class="text-sm font-bold text-[var(--ml-color-river-700)] hover:underline inline-flex items-center gap-1 no-underline">
          <span>Voir toute la bibliothèque</span>
          <span>&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-[var(--ml-color-neutral-200)] shadow-sm">
          <span class="text-[11px] font-bold uppercase px-2.5 py-0.5 rounded-full bg-[var(--ml-color-mandingue-orange)] text-white mb-3 inline-block">Palettes & Nuanciers</span>
          <h3 class="text-base font-bold text-[var(--ml-color-neutral-900)] mb-2 font-title">Couleurs Officielles</h3>
          <p class="text-xs text-[var(--ml-color-neutral-600)] leading-relaxed mb-4">Orange Mandingue, Vert République, Bleu Fleuve Niger, Indigo de Ségou, Ocre Bogolan.</p>
          <div class="flex gap-2">
            <span class="w-6 h-6 rounded-full bg-[var(--ml-color-mandingue-orange)] shadow-inner"></span>
            <span class="w-6 h-6 rounded-full bg-[var(--ml-color-green-500)] shadow-inner"></span>
            <span class="w-6 h-6 rounded-full bg-[var(--ml-color-river-500)] shadow-inner"></span>
            <span class="w-6 h-6 rounded-full bg-[var(--ml-color-indigo-500)] shadow-inner"></span>
            <span class="w-6 h-6 rounded-full bg-[var(--ml-color-bogolan-argile)] shadow-inner"></span>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-[var(--ml-color-neutral-200)] shadow-sm">
          <span class="text-[11px] font-bold uppercase px-2.5 py-0.5 rounded-full bg-[var(--ml-color-river-600)] text-white mb-3 inline-block">Boutons & Actions</span>
          <h3 class="text-base font-bold text-[var(--ml-color-neutral-900)] mb-2 font-title">Éléments Interactifs</h3>
          <p class="text-xs text-[var(--ml-color-neutral-600)] leading-relaxed mb-4">Boutons primaires, secondaires, badges d'état et éléments de navigation.</p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 bg-[var(--ml-color-mandingue-orange)] text-white text-xs font-bold rounded-lg shadow-sm">Bouton</span>
            <span class="px-3 py-1 bg-[var(--ml-color-river-50)] text-[var(--ml-color-river-800)] text-xs font-bold rounded-lg border border-[var(--ml-color-river-200)]">Secondaire</span>
            <span class="px-2.5 py-0.5 bg-emerald-100 text-emerald-800 text-[10px] font-bold rounded-full">Actif</span>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-[var(--ml-color-neutral-200)] shadow-sm">
          <span class="text-[11px] font-bold uppercase px-2.5 py-0.5 rounded-full bg-[var(--ml-color-indigo-600)] text-white mb-3 inline-block">Formulaires & Steppers</span>
          <h3 class="text-base font-bold text-[var(--ml-color-neutral-900)] mb-2 font-title">Saisie Administrative</h3>
          <p class="text-xs text-[var(--ml-color-neutral-600)] leading-relaxed mb-4">Steppers multi-étapes, sélecteurs, zones de téléversement et validation.</p>
          <div class="flex items-center gap-2 text-xs font-bold text-[var(--ml-color-river-700)]">
            <span class="w-5 h-5 rounded-full bg-[var(--ml-color-river-600)] text-white text-[10px] flex items-center justify-center">1</span>
            <span class="h-0.5 bg-[var(--ml-color-river-300)] flex-1"></span>
            <span class="w-5 h-5 rounded-full bg-[var(--ml-color-mandingue-orange)] text-white text-[10px] flex items-center justify-center">2</span>
            <span class="h-0.5 bg-stone-200 flex-1"></span>
            <span class="w-5 h-5 rounded-full bg-stone-200 text-stone-600 text-[10px] flex items-center justify-center">3</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 3: EXEMPLES DE PAGES DE DÉMO -->
  <section id="services" class="py-16 bg-white border-b border-[var(--ml-color-neutral-200)]">
    <div class="ml-container max-w-6xl mx-auto px-4">
      <div class="text-center mb-12 max-w-2xl mx-auto">
        <span class="text-xs font-bold uppercase tracking-wider text-[var(--ml-color-river-700)] bg-[var(--ml-color-river-100)] px-3.5 py-1 rounded-full mb-3 inline-block border border-[var(--ml-color-river-200)]" data-cms-bind="src/data/pages/home.json::servicesSection.badge">
          {homeData.servicesSection.badge}
        </span>
        <h2 class="text-3xl font-black text-[var(--ml-color-neutral-900)] font-title" data-cms-bind="src/data/pages/home.json::servicesSection.title">{homeData.servicesSection.title}</h2>
        <p class="text-[var(--ml-color-neutral-600)] mt-2 text-sm" data-cms-bind="src/data/pages/home.json::servicesSection.subtitle">{homeData.servicesSection.subtitle}</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featuredServices.map((service) => (
          <ServiceCard {...service} />
        ))}
      </div>

      <div class="text-center mt-10">
        <a href="/services" class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--ml-color-river-700)] hover:bg-[var(--ml-color-river-800)] text-white font-bold rounded-xl transition-all shadow-sm no-underline text-sm">
          <span>Consulter toutes les démarches exemples</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- SECTION 4: ACTUALITÉS DÉMO & APPEL À L'ACTION -->
  <section class="py-16 bg-[var(--ml-color-bogolan-kaolin)]/50 border-b border-[var(--ml-color-neutral-200)]">
    <div class="ml-container max-w-6xl mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div>
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--ml-color-mandingue-700)] bg-[var(--ml-color-mandingue-50)] px-3 py-1 rounded-full mb-3 inline-block border border-[var(--ml-color-mandingue-100)]" data-cms-bind="src/data/pages/home.json::newsSection.badge">
            {homeData.newsSection.badge}
          </span>
          <h2 class="text-2xl md:text-3xl font-black text-[var(--ml-color-neutral-900)] font-title mb-4" data-cms-bind="src/data/pages/home.json::newsSection.title">
            {homeData.newsSection.title}
          </h2>
          <p class="text-sm text-[var(--ml-color-neutral-600)] leading-relaxed mb-6" data-cms-bind="src/data/pages/home.json::newsSection.subtitle">
            {homeData.newsSection.subtitle}
          </p>
          <a href="/actualites" class="inline-flex items-center gap-2 px-6 py-3 bg-[var(--ml-color-mandingue-orange)] hover:bg-[var(--ml-color-mandingue-700)] text-white font-bold rounded-xl transition-all shadow-sm no-underline text-xs">
            <span>Voir la démo Actualités</span>
            <span>&rarr;</span>
          </a>
        </div>

        <div class="space-y-4">
          {newsPreview.map((item) => (
            <article class="bg-white border border-[var(--ml-color-neutral-200)] rounded-2xl p-6 hover:shadow-md transition-shadow">
              <div class="flex justify-between items-center text-xs text-[var(--ml-color-neutral-500)] mb-2">
                <span class="bg-[var(--ml-color-mandingue-50)] text-[var(--ml-color-mandingue-900)] font-bold px-2.5 py-0.5 rounded-md border border-[var(--ml-color-mandingue-100)]">{item.category}</span>
                <time>{item.date}</time>
              </div>
              <h3 class="text-base font-extrabold text-[var(--ml-color-neutral-900)] font-title mb-2">
                <a href={item.href} class="hover:text-[var(--ml-color-river-700)] text-[var(--ml-color-neutral-900)] no-underline">{item.title}</a>
              </h3>
              <p class="text-[var(--ml-color-neutral-600)] text-xs leading-relaxed">{item.excerpt}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Footer
    slot="footer"
    institution={siteConfig.institution}
    contact={siteConfig.contact}
    footerLinks={siteConfig.footerLinks}
  />
</BaseLayout>
