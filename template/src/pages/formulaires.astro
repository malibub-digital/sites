---
import BaseLayout from '@malihub/sites-core/layouts/BaseLayout.astro';
import Header from '@malihub/sites-core/components/Header.astro';
import Footer from '@malihub/sites-core/components/Footer.astro';
import siteConfig from '../../site.config.json';
---

<BaseLayout title={`Démonstration des Formulaires DSML — ${siteConfig.title}`} description="Vitrine complète des composants de formulaires interactifs, steppers, sélecteurs et zones de téléversement certifiés DSML.">
  <Header
    slot="header"
    title={siteConfig.title}
    institution={siteConfig.institution}
    logoUrl={siteConfig.logoUrl}
    navItems={siteConfig.navigation?.links}
    currentPath="/formulaires"
  />

  <main id="main-content" class="py-12 bg-[var(--ml-color-bogolan-kaolin)]/50 min-h-screen">
    <div class="ml-container max-w-5xl mx-auto px-4">
      <nav class="text-xs text-[var(--ml-color-neutral-500)] mb-6 flex gap-2">
        <a href="/" class="hover:underline text-[var(--ml-color-neutral-600)]">Accueil</a>
        <span>/</span>
        <span class="text-[var(--ml-color-neutral-800)] font-semibold">Formulaires DSML</span>
      </nav>

      <!-- Banner Header -->
      <div class="relative rounded-3xl overflow-hidden mb-12 bg-gradient-to-r from-[var(--ml-color-river-800)] via-[var(--ml-color-indigo-700)] to-[var(--ml-color-indigo-900)] text-white p-8 md:p-12 shadow-xl border-2 border-[var(--ml-color-mandingue-orange)]/50">
        <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-[var(--ml-color-mandingue-500)] via-transparent to-transparent pointer-events-none"></div>
        <div class="relative z-10 max-w-2xl">
          <span class="inline-flex items-center gap-1.5 bg-white/15 text-[var(--ml-color-mandingue-100)] text-xs font-bold px-3.5 py-1 rounded-full uppercase tracking-wider mb-4 border border-white/20 backdrop-blur-md">
            Composants Officiels DSML
          </span>
          <h1 class="text-3xl md:text-4xl font-black font-title tracking-tight text-[var(--ml-color-mandingue-100)] mb-3 drop-shadow-md">Formulaires Administratifs</h1>
          <p class="text-sm md:text-base text-white/95 leading-relaxed font-medium">
            Découvrez la richesse et l'accessibilité des formulaires multi-étapes, champs validés, sélecteurs et zones de dépôts certifiés par le Design System Mali.
          </p>
        </div>
      </div>

      <!-- STEPPER PROCESS SHOWCASE -->
      <div class="bg-white p-6 md:p-8 rounded-3xl border border-[var(--ml-color-neutral-200)] shadow-sm mb-10">
        <h2 class="text-lg font-extrabold text-[var(--ml-color-neutral-900)] font-title mb-6 border-b border-[var(--ml-color-neutral-200)] pb-3">
          1. Composant Stepper (Procédure Multi-Étapes)
        </h2>

        <ol class="flex items-center w-full text-xs md:text-sm font-medium text-center text-[var(--ml-color-neutral-500)]">
          <li class="flex md:w-full items-center text-[var(--ml-color-river-700)] after:content-[''] after:w-full after:h-1 after:border-b after:border-[var(--ml-color-river-500)] after:hidden md:after:inline-block after:mx-6">
            <span class="flex items-center font-bold">
              <span class="w-7 h-7 rounded-full bg-[var(--ml-color-river-600)] text-white text-xs flex items-center justify-center mr-2 shadow-sm">1</span>
              <span>Identité Usager</span>
            </span>
          </li>
          <li class="flex md:w-full items-center text-[var(--ml-color-mandingue-700)] after:content-[''] after:w-full after:h-1 after:border-b after:border-[var(--ml-color-mandingue-300)] after:hidden md:after:inline-block after:mx-6">
            <span class="flex items-center font-bold">
              <span class="w-7 h-7 rounded-full bg-[var(--ml-color-mandingue-orange)] text-white text-xs flex items-center justify-center mr-2 shadow-sm ring-4 ring-[var(--ml-color-mandingue-50)]">2</span>
              <span>Téléversement Documents</span>
            </span>
          </li>
          <li class="flex items-center text-[var(--ml-color-neutral-400)]">
            <span class="w-7 h-7 rounded-full bg-[var(--ml-color-neutral-200)] text-[var(--ml-color-neutral-600)] text-xs flex items-center justify-center mr-2">3</span>
            <span>Validation & Récépissé</span>
          </li>
        </ol>
      </div>

      <!-- FORM FIELDS DEMO GRID -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-10">

        <!-- Colonne 1: Champs de saisie & Sélecteurs -->
        <div class="bg-white p-8 rounded-3xl border border-[var(--ml-color-neutral-200)] shadow-sm space-y-6">
          <h2 class="text-lg font-extrabold text-[var(--ml-color-neutral-900)] font-title border-b border-[var(--ml-color-neutral-200)] pb-3 m-0">
            2. Inputs, Selects & Date Pickers
          </h2>

          <div>
            <label for="num-nina" class="block text-xs font-bold text-[var(--ml-color-neutral-800)] uppercase tracking-wider mb-2">
              Numéro NINA / RAVEC <span class="text-red-500">*</span>
            </label>
            <input type="text" id="num-nina" placeholder="Ex: 1 98 04 999 012345 M" class="w-full px-4 py-2.5 bg-white border border-[var(--ml-color-neutral-300)] rounded-xl text-sm focus:outline-none focus:border-[var(--ml-color-river-600)] focus:ring-2 focus:ring-[var(--ml-color-river-100)] transition-all" />
            <p class="text-[11px] text-[var(--ml-color-neutral-500)] mt-1.5">Numéro d'identification à 14 chiffres présent sur votre extrait sécurisé.</p>
          </div>

          <div>
            <label for="consulat-select" class="block text-xs font-bold text-[var(--ml-color-neutral-800)] uppercase tracking-wider mb-2">
              Consulat / Centre d'enrôlement <span class="text-red-500">*</span>
            </label>
            <select id="consulat-select" class="w-full px-4 py-2.5 bg-white border border-[var(--ml-color-neutral-300)] rounded-xl text-sm text-[var(--ml-color-neutral-900)] focus:outline-none focus:border-[var(--ml-color-river-600)] focus:ring-2 focus:ring-[var(--ml-color-river-100)] transition-all">
              <option value="">Sélectionnez votre centre consulaire...</option>
              <option value="paris">Ambassade du Mali à Paris (France)</option>
              <option value="lyon">Consulat Général du Mali à Lyon</option>
              <option value="abidjan">Consulat Général à Abidjan (Côte d'Ivoire)</option>
              <option value="bamako">Guichet Unique du District de Bamako</option>
            </select>
          </div>

          <div>
            <label for="date-naissance" class="block text-xs font-bold text-[var(--ml-color-neutral-800)] uppercase tracking-wider mb-2">
              Date de Naissance
            </label>
            <input type="date" id="date-naissance" class="w-full px-4 py-2.5 bg-white border border-[var(--ml-color-neutral-300)] rounded-xl text-sm focus:outline-none focus:border-[var(--ml-color-river-600)] focus:ring-2 focus:ring-[var(--ml-color-river-100)] transition-all" />
          </div>

          <!-- Radio Options DSML -->
          <div>
            <label class="block text-xs font-bold text-[var(--ml-color-neutral-800)] uppercase tracking-wider mb-3">
              Type de Demande
            </label>
            <div class="grid grid-cols-2 gap-3">
              <label class="flex items-center gap-3 p-3 rounded-xl border border-[var(--ml-color-river-200)] bg-[var(--ml-color-river-50)]/50 cursor-pointer hover:bg-[var(--ml-color-river-50)] transition-colors">
                <input type="radio" name="type_demande" checked class="text-[var(--ml-color-river-600)] focus:ring-0" />
                <span class="text-xs font-bold text-[var(--ml-color-neutral-800)]">Première demande</span>
              </label>
              <label class="flex items-center gap-3 p-3 rounded-xl border border-[var(--ml-color-neutral-200)] bg-white cursor-pointer hover:bg-[var(--ml-color-neutral-50)] transition-colors">
                <input type="radio" name="type_demande" class="text-[var(--ml-color-river-600)] focus:ring-0" />
                <span class="text-xs font-bold text-[var(--ml-color-neutral-800)]">Renouvellement</span>
              </label>
            </div>
          </div>
        </div>

        <!-- Colonne 2: Drag & Drop Zone, Checkboxes & Validation States -->
        <div class="bg-white p-8 rounded-3xl border border-[var(--ml-color-neutral-200)] shadow-sm space-y-6">
          <h2 class="text-lg font-extrabold text-[var(--ml-color-neutral-900)] font-title border-b border-[var(--ml-color-neutral-200)] pb-3 m-0">
            3. Upload Zone & États de Validation
          </h2>

          <!-- File Upload Drag & Drop Area -->
          <div>
            <label class="block text-xs font-bold text-[var(--ml-color-neutral-800)] uppercase tracking-wider mb-2">
              Téléversement de l'Acte de Naissance (PDF ou JPG, Max 5 Mo)
            </label>
            <div class="flex justify-center px-6 pt-6 pb-6 border-2 border-dashed border-[var(--ml-color-mandingue-300)] rounded-2xl bg-[var(--ml-color-mandingue-50)]/40 hover:bg-[var(--ml-color-mandingue-50)] transition cursor-pointer text-center">
              <div class="space-y-2">
                <div class="w-12 h-12 rounded-full bg-[var(--ml-color-mandingue-100)] text-[var(--ml-color-mandingue-700)] flex items-center justify-center mx-auto">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>
                </div>
                <div class="text-xs text-[var(--ml-color-neutral-700)]">
                  <span class="font-extrabold text-[var(--ml-color-mandingue-700)] hover:underline">Cliquer pour parcourir</span>
                  <span> ou glisser-déposer le fichier ici</span>
                </div>
                <p class="text-[10px] text-[var(--ml-color-neutral-500)]">Formats autorisés : PDF, PNG, JPEG certifiés</p>
              </div>
            </div>
          </div>

          <!-- Validation Success State Example -->
          <div>
            <label for="input-success" class="block text-xs font-bold text-emerald-800 uppercase tracking-wider mb-2">
              Adresse email vérifiée (État Valide)
            </label>
            <div class="relative">
              <input type="email" id="input-success" value="citoyen.mali@consulat.ml" readonly class="w-full px-4 py-2.5 bg-emerald-50/50 border-2 border-emerald-500 rounded-xl text-sm font-semibold text-emerald-950 focus:outline-none" />
              <span class="absolute right-3 top-3 text-emerald-600 font-bold">✓</span>
            </div>
            <p class="text-[11px] text-emerald-700 font-semibold mt-1">✓ Adresse électronique valide et certifiée par le système.</p>
          </div>

          <!-- Checkbox Terms -->
          <div class="pt-2">
            <label class="flex items-start gap-3 cursor-pointer">
              <input type="checkbox" checked class="mt-1 rounded text-[var(--ml-color-mandingue-orange)] focus:ring-0" />
              <span class="text-xs text-[var(--ml-color-neutral-700)] leading-relaxed">
                J'atteste sur l'honneur l'exactitude des informations fournies et j'accepte les <a href="/mentions-legales" class="text-[var(--ml-color-river-700)] font-bold hover:underline">conditions générales d'utilisation</a> des services publics du Mali.
              </span>
            </label>
          </div>
        </div>
      </div>

      <!-- SUBMIT ACTION BAR DEMO -->
      <div class="bg-gradient-to-r from-[var(--ml-color-river-800)] to-[var(--ml-color-indigo-900)] p-8 rounded-3xl text-white flex flex-wrap items-center justify-between gap-6 shadow-lg">
        <div>
          <h3 class="text-lg font-black font-title m-0 mb-1">Valider et Transmettre ma Démarche</h3>
          <p class="text-xs text-white/80 m-0">Accusé de réception et numéro de suivi transmis en temps réel.</p>
        </div>
        <a href="/contact-succes" class="px-8 py-3.5 bg-[var(--ml-color-mandingue-orange)] hover:bg-[var(--ml-color-mandingue-700)] text-white font-bold rounded-xl text-sm shadow-md transition-all no-underline inline-flex items-center gap-2">
          <span>Soumettre le Formulaire</span>
          <span>&rarr;</span>
        </a>
      </div>

    </div>
  </main>

  <Footer
    slot="footer"
    institution={siteConfig.institution}
    contact={siteConfig.contact}
    footerLinks={siteConfig.footerLinks}
  />
</BaseLayout>
