---
import CollectionAddButton from './CollectionAddButton.astro';
import CollectionItemControls from './CollectionItemControls.astro';
import type { FooterColumn } from '../schemas/index.js';

interface Props {
  institution?: string;
  contact?: {
    email: string;
    phone: string;
    address: string;
    hours?: string;
  };
  footerLinks?: FooterColumn[];
}

const {
  institution = 'RÉPUBLIQUE DU MALI',
  contact = {
    email: 'contact@sitesfaciles.gouv.ml',
    phone: '+223 20 22 00 00',
    address: 'Cité Administrative, Bâtiment Numérique, Bamako, République du Mali',
  },
  footerLinks = [],
} = Astro.props;
---

<footer class="ml-footer" aria-label="Pied de page">
  <div class="ml-container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="brand-block">
          <div class="ml-flag" aria-hidden="true">
            <div class="green"></div>
            <div class="yellow"></div>
            <div class="red"></div>
          </div>
          <div class="brand-text">
            <div class="brand-title" data-cms-bind="siteConfig.institution">{institution}</div>
            <div class="brand-motto">Un Peuple – Un But – Une Foi</div>
          </div>
        </div>
        <div class="footer-coords">
          <strong>Sites Faciles Mali</strong><br />
          <span data-cms-bind="siteConfig.contact.address">{contact.address}</span><br />
          <span>Email : <a href={`mailto:${contact.email}`} data-cms-bind="siteConfig.contact.email">{contact.email}</a></span><br />
          <span>Tél : <span data-cms-bind="siteConfig.contact.phone">{contact.phone}</span></span>
        </div>
      </div>

      <div class="footer-links-container">
        {footerLinks.map((col, colIndex) => (
          <nav class="footer-col" aria-label={col.colTitle} data-cms-collection={`siteConfig.footerLinks.[${colIndex}].links`}>
            <div class="footer-col-title" data-cms-bind={`siteConfig.footerLinks.[${colIndex}].colTitle`}>{col.colTitle}</div>
            {col.links.map((link, linkIndex) => (
              <div class="footer-link-item" data-cms-item-index={linkIndex}>
                <a href={link.href} data-cms-bind={`siteConfig.footerLinks.[${colIndex}].links.[${linkIndex}].label`}>{link.label}</a>
                <CollectionItemControls
                  collectionPath={`siteConfig.footerLinks.[${colIndex}].links`}
                  index={linkIndex}
                  isFirst={linkIndex === 0}
                  isLast={linkIndex === col.links.length - 1}
                />
              </div>
            ))}
            <CollectionAddButton
              collectionPath={`siteConfig.footerLinks.[${colIndex}].links`}
              label="Ajouter un lien"
              defaultData={{ label: "Nouveau lien", href: "/" }}
            />
          </nav>
        ))}
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-bottom-links">
        <a href="/mentions-legales">Mentions légales</a>
        <a href="/accessibilite">Accessibilité : partiellement conforme</a>
      </div>
      <div class="footer-credits">
        © {new Date().getFullYear()} République du Mali — Propulsé par Sites Faciles Mali & DSML
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-link-item {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }
  .footer-link-item > a {
    flex: 1;
  }
</style>
