---
interface Props {
  collectionPath: string;
  collectionType?: 'json' | 'content';
  label?: string;
  defaultData?: Record<string, any>;
  class?: string;
}

const {
  collectionPath,
  collectionType = 'json',
  label = collectionType === 'content' ? 'Ajouter un document' : 'Ajouter un élément',
  defaultData,
  class: className = '',
} = Astro.props;
---

<div class={`ml-cms-collection-add-container ${className}`} data-cms-collection-add={collectionPath}>
  <button
    type="button"
    class={`ml-btn ${collectionType === 'content' ? 'ml-btn--primary' : 'ml-btn--secondary'} ml-btn--sm ml-cms-add-btn`}
    data-collection-path={collectionPath}
    data-collection-type={collectionType}
    data-default-data={defaultData ? JSON.stringify(defaultData) : ''}
  >
    <i class={collectionType === 'content' ? 'ml-icon-file-add-line ml-icon--xs' : 'ml-icon-add-line ml-icon--xs'}></i>
    <span>{label}</span>
  </button>
</div>

<style>
  .ml-cms-collection-add-container {
    display: none;
    justify-content: center;
    padding: 0.75rem 0;
    margin: 0.5rem 0;
    width: 100%;
  }

  :global(:root[data-cms-editing="true"]) .ml-cms-collection-add-container,
  :global(body.cms-mode-editing) .ml-cms-collection-add-container {
    display: flex !important;
  }
</style>

<script>
  import { addArrayItem } from '../store/cms.js';

  function attachGlobalAddButtonsHandler() {
    if ((window as any).__ml_cms_add_button_listener) return;
    (window as any).__ml_cms_add_button_listener = true;

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.ml-cms-add-btn') as HTMLButtonElement | null;
      if (!btn) return;

      e.preventDefault();
      e.stopPropagation();

      const path = btn.getAttribute('data-collection-path');
      const type = btn.getAttribute('data-collection-type');
      const rawData = btn.getAttribute('data-default-data');

      if (!path) return;

      if (type === 'content') {
        const modal = document.getElementById('ml-cms-create-content-modal');
        const collectionInput = document.getElementById('ml-create-content-collection') as HTMLInputElement | null;
        if (collectionInput) collectionInput.value = path;
        modal?.classList.remove('hidden');
      } else {
        let defaultData: any = { question: "Nouvelle question posée ?", answer: "Saisissez la réponse de l'administration." };
        if (rawData) {
          try { defaultData = JSON.parse(rawData); } catch {}
        }
        addArrayItem(path, defaultData);

        const collectionContainer = btn.closest('[data-cms-collection]') || document.querySelector(`[data-cms-collection="${path}"]`);
        if (collectionContainer) {
          const listWrapper = collectionContainer.querySelector('.space-y-4') || collectionContainer;
          const existingItems = collectionContainer.querySelectorAll('[data-cms-item-index]');
          const newIndex = existingItems.length;

          const newItem = document.createElement('div');
          newItem.className = "ml-accordion bg-white !p-6 border border-[var(--ml-color-neutral-200)] rounded-2xl shadow-sm hover:shadow-md transition-all relative group";
          newItem.style.cssText = "padding: 1.25rem 1.5rem !important; border-bottom: 1px solid var(--ml-color-neutral-200);";
          newItem.setAttribute('data-cms-item-index', String(newIndex));

          const questionText = defaultData.question || defaultData.title || `Nouvel élément #${newIndex + 1}`;
          const answerText = defaultData.answer || defaultData.description || defaultData.summary || "Saisissez le contenu ici.";

          const isFirst = newIndex === 0;

          newItem.innerHTML = `
            <div class="ml-accordion-header flex items-center justify-between gap-4">
              <button type="button" class="ml-accordion-title text-base font-extrabold text-[var(--ml-color-neutral-900)] font-title m-0 flex-1 text-left cursor-pointer focus:outline-none" aria-expanded="true">
                <span data-cms-bind="${path}.[${newIndex}].question">
                  ${questionText}
                </span>
              </button>
              <div class="ml-cms-item-controls-toolbar" data-cms-item-toolbar>
                <button type="button" class="ml-cms-item-btn ml-cms-item-up" title="Monter" data-action="up" data-collection-path="${path}" data-index="${newIndex}" ${isFirst ? 'disabled' : ''}>
                  <i class="ml-icon-arrow-up-line ml-icon--xs"></i>
                </button>
                <button type="button" class="ml-cms-item-btn ml-cms-item-down" title="Descendre" data-action="down" data-collection-path="${path}" data-index="${newIndex}" disabled>
                  <i class="ml-icon-arrow-down-line ml-icon--xs"></i>
                </button>
                <button type="button" class="ml-cms-item-btn ml-cms-item-delete" title="Supprimer" data-action="delete-array" data-collection-path="${path}" data-index="${newIndex}">
                  <i class="ml-icon-delete-bin-line ml-icon--xs"></i>
                </button>
              </div>
            </div>
            <div class="ml-accordion-content pt-3 mt-3 border-t border-[var(--ml-color-neutral-100)]">
              <p class="text-[var(--ml-color-neutral-600)] text-sm leading-relaxed m-0" data-cms-bind="${path}.[${newIndex}].answer">
                ${answerText}
              </p>
            </div>
          `;

          listWrapper.appendChild(newItem);

          // Update down button state of previous item since it's no longer the last item
          if (newIndex > 0) {
            const prevItem = existingItems[newIndex - 1];
            const prevDownBtn = prevItem?.querySelector('.ml-cms-item-down') as HTMLButtonElement | null;
            if (prevDownBtn) prevDownBtn.disabled = false;
          }
        }
      }
    });
  }

  attachGlobalAddButtonsHandler();
  document.addEventListener('astro:after-swap', attachGlobalAddButtonsHandler);
</script>
