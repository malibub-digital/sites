---
interface Props {
  collectionPath: string;
  index?: number;
  slug?: string;
  type?: 'json' | 'content';
  isFirst?: boolean;
  isLast?: boolean;
  class?: string;
}

const {
  collectionPath,
  index = 0,
  slug = '',
  type = 'json',
  isFirst = false,
  isLast = false,
  class: className = '',
} = Astro.props;
---

<div class={`ml-cms-item-controls-toolbar ${className}`} data-cms-item-toolbar>
  {type === 'json' ? (
    <>
      <button
        type="button"
        class="ml-cms-item-btn ml-cms-item-up"
        title="Monter"
        data-action="up"
        data-collection-path={collectionPath}
        data-index={index}
        disabled={isFirst}
      >
        <i class="ml-icon-arrow-up-line ml-icon--xs"></i>
      </button>
      <button
        type="button"
        class="ml-cms-item-btn ml-cms-item-down"
        title="Descendre"
        data-action="down"
        data-collection-path={collectionPath}
        data-index={index}
        disabled={isLast}
      >
        <i class="ml-icon-arrow-down-line ml-icon--xs"></i>
      </button>
      <button
        type="button"
        class="ml-cms-item-btn ml-cms-item-delete"
        title="Supprimer"
        data-action="delete-array"
        data-collection-path={collectionPath}
        data-index={index}
      >
        <i class="ml-icon-delete-bin-line ml-icon--xs"></i>
      </button>
    </>
  ) : (
    <button
      type="button"
      class="ml-cms-item-btn ml-cms-item-delete"
      title="Supprimer l'article"
      data-action="delete-file"
      data-collection-path={collectionPath}
      data-slug={slug}
    >
      <i class="ml-icon-delete-bin-line ml-icon--xs"></i>
    </button>
  )}
</div>

<style is:global>
  .ml-cms-item-controls-toolbar {
    display: none;
    align-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
  }

  :root[data-cms-editing="true"] .ml-cms-item-controls-toolbar,
  body.cms-mode-editing .ml-cms-item-controls-toolbar {
    display: inline-flex !important;
  }

  .ml-cms-item-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #475569;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 0;
    line-height: 1;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .ml-cms-item-btn:hover:not([disabled]) {
    transform: translateY(-1px);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .ml-cms-item-up:hover:not([disabled]),
  .ml-cms-item-down:hover:not([disabled]) {
    border-color: #0284c7;
    color: #0284c7;
    background: #f0f9ff;
  }

  .ml-cms-item-delete:hover:not([disabled]) {
    border-color: #e11d48;
    color: #e11d48;
    background: #fff1f2;
  }

  .ml-cms-item-btn[disabled] {
    opacity: 0.3;
    cursor: not-allowed;
    border-color: #e2e8f0;
    color: #94a3b8;
    background: #f8fafc;
    box-shadow: none;
  }
</style>

<script>
  import { reorderArrayItem, deleteArrayItem, deleteContentFile } from '../store/cms.js';

  function reindexCollectionItems(container: Element, colPath: string) {
    const allItems = Array.from(container.querySelectorAll('[data-cms-item-index]'));
    allItems.forEach((el, newIdx) => {
      el.setAttribute('data-cms-item-index', String(newIdx));

      const upBtn = el.querySelector('.ml-cms-item-up') as HTMLButtonElement | null;
      const downBtn = el.querySelector('.ml-cms-item-down') as HTMLButtonElement | null;
      const deleteBtn = el.querySelector('.ml-cms-item-delete') as HTMLButtonElement | null;

      if (upBtn) {
        upBtn.setAttribute('data-index', String(newIdx));
        upBtn.disabled = newIdx === 0;
      }
      if (downBtn) {
        downBtn.setAttribute('data-index', String(newIdx));
        downBtn.disabled = newIdx === allItems.length - 1;
      }
      if (deleteBtn) {
        deleteBtn.setAttribute('data-index', String(newIdx));
      }

      const bindElements = el.querySelectorAll('[data-cms-bind]');
      bindElements.forEach((bindEl) => {
        const currentBind = bindEl.getAttribute('data-cms-bind') || '';
        const updatedBind = currentBind.replace(
          new RegExp(`^${colPath.replace('.', '\\.')}\\.\\[\\d+\\]`),
          `${colPath}.[${newIdx}]`
        );
        bindEl.setAttribute('data-cms-bind', updatedBind);
      });
    });
  }

  function attachGlobalItemControlsHandler() {
    if ((window as any).__ml_cms_item_controls_listener) return;
    (window as any).__ml_cms_item_controls_listener = true;

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.ml-cms-item-btn') as HTMLButtonElement | null;
      if (!btn || btn.disabled) return;

      e.preventDefault();
      e.stopPropagation();

      const action = btn.getAttribute('data-action');
      const path = btn.getAttribute('data-collection-path') || '';
      const slug = btn.getAttribute('data-slug') || '';

      const itemEl = btn.closest('[data-cms-item-index]') as HTMLElement | null;
      const container = itemEl?.closest('[data-cms-collection]') || itemEl?.parentElement;

      if (!itemEl || !container) return;

      const itemsList = Array.from(container.querySelectorAll(':scope > .space-y-4 > [data-cms-item-index], :scope > [data-cms-item-index]'));
      const currentDomIdx = itemsList.indexOf(itemEl);

      if (action === 'up') {
        if (currentDomIdx > 0) {
          const prevItem = itemsList[currentDomIdx - 1];
          reorderArrayItem(path, currentDomIdx, currentDomIdx - 1);
          itemEl.parentNode?.insertBefore(itemEl, prevItem);
          reindexCollectionItems(container, path);
        }
      } else if (action === 'down') {
        if (currentDomIdx >= 0 && currentDomIdx < itemsList.length - 1) {
          const nextItem = itemsList[currentDomIdx + 1];
          reorderArrayItem(path, currentDomIdx, currentDomIdx + 1);
          itemEl.parentNode?.insertBefore(nextItem, itemEl);
          reindexCollectionItems(container, path);
        }
      } else if (action === 'delete-array') {
        if (currentDomIdx >= 0) {
          deleteArrayItem(path, currentDomIdx);
          itemEl.style.opacity = '0.3';
          itemEl.style.textDecoration = 'line-through';
          itemEl.style.pointerEvents = 'none';
        }
      } else if (action === 'delete-file') {
        deleteContentFile(path, slug);
        const fileItemEl = btn.closest('[data-cms-file]') as HTMLElement | null;
        if (fileItemEl) {
          fileItemEl.style.opacity = '0.3';
          fileItemEl.style.textDecoration = 'line-through';
          fileItemEl.style.pointerEvents = 'none';
        }
      }
    });
  }

  attachGlobalItemControlsHandler();
  document.addEventListener('astro:after-swap', attachGlobalItemControlsHandler);
</script>
