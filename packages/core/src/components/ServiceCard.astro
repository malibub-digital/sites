---
interface Props {
  title: string;
  summary: string;
  category: string;
  cost?: string;
  processingTime?: string;
  href: string;
  badgeText?: string;
  icon?: string;
  variant?: 'standard' | 'featured' | 'accent' | 'indigo' | 'mandingue' | 'ambre' | 'soleil';
  cmsSlug?: string;
}

const { title, summary, category, cost = 'Gratuit', processingTime, href, badgeText, icon, variant = 'standard', cmsSlug } = Astro.props;
const cmsBase = cmsSlug ? `src/content/services/${cmsSlug}.md` : null;
const b = (field: string) => cmsBase ? `${cmsBase}::${field}` : undefined;


const cardStyles = {
  standard: 'bg-[var(--ml-bg-surface)] border-[var(--ml-border-subtle)] hover:border-[var(--ml-color-green-400)] shadow-sm hover:shadow-md',
  featured: 'bg-[var(--ml-bg-surface)] border-2 border-[var(--ml-color-green-500)] shadow-md hover:shadow-lg',
  accent: 'bg-[var(--ml-bg-surface)] border border-[var(--ml-color-gold-400)] shadow-sm hover:shadow-md',
  indigo: 'bg-[var(--ml-bg-surface)] border border-[var(--ml-color-indigo-300)] shadow-sm hover:shadow-md',
  mandingue: 'bg-[var(--ml-bg-surface)] border border-[var(--ml-color-mandingue-500)] shadow-sm hover:shadow-md',
  ambre: 'bg-[var(--ml-bg-surface)] border border-[var(--ml-color-ambre-500)] shadow-sm hover:shadow-md',
  soleil: 'bg-[var(--ml-bg-surface)] border-2 border-[var(--ml-color-soleil-or)] shadow-md hover:shadow-lg'
};

const badgeStyles = {
  standard: 'bg-[var(--ml-color-green-50)] text-[var(--ml-color-green-800)] border border-[var(--ml-color-green-200)]',
  featured: 'bg-[var(--ml-color-green-600)] text-white font-bold',
  accent: 'bg-[var(--ml-color-gold-400)] text-[#1C1917] font-bold',
  indigo: 'bg-[var(--ml-color-indigo-600)] text-white font-bold',
  mandingue: 'bg-[var(--ml-color-mandingue-orange)] text-white font-bold',
  ambre: 'bg-[var(--ml-color-ambre-sahel)] text-white font-bold',
  soleil: 'bg-[var(--ml-color-soleil-or)] text-[#1C1917] font-bold'
};

const iconStyles = {
  standard: 'bg-[var(--ml-color-green-100)] text-[var(--ml-color-green-800)] border-[var(--ml-color-green-200)]',
  featured: 'bg-[var(--ml-color-green-600)] text-white border-[var(--ml-color-green-700)] shadow-md',
  accent: 'bg-[var(--ml-color-gold-100)] text-[var(--ml-color-gold-800)] border-[var(--ml-color-gold-300)]',
  indigo: 'bg-[var(--ml-color-indigo-100)] text-[var(--ml-color-indigo-700)] border-[var(--ml-color-indigo-300)]',
  mandingue: 'bg-[var(--ml-color-mandingue-100)] text-[var(--ml-color-mandingue-800)] border-[var(--ml-color-mandingue-300)]',
  ambre: 'bg-[var(--ml-color-ambre-100)] text-[var(--ml-color-ambre-800)] border-[var(--ml-color-ambre-300)]',
  soleil: 'bg-[var(--ml-color-soleil-500)] text-[#1C1917] border-[var(--ml-color-soleil-or)] shadow-md'
};
---

<a href={href} class={`ml-card group block relative no-underline rounded-2xl transition-all duration-200 p-6 flex flex-col justify-between ${cardStyles[variant]}`}>
  <div>
    <div class="flex items-start justify-between gap-3 mb-4">
      {icon && (
        <span class={`w-14 h-14 rounded-2xl flex items-center justify-center shrink-0 shadow-sm border group-hover:scale-105 transition-transform duration-200 ${iconStyles[variant]}`}>
          <i class={`${icon} ml-icon--lg`}></i>
        </span>
      )}
      <div class="flex flex-wrap items-center justify-end gap-1.5 ml-auto">
        <span class="text-[11px] font-semibold text-[var(--ml-text-secondary)] bg-[var(--ml-bg-surface-subtle)] px-2.5 py-0.5 rounded-full border border-[var(--ml-border-subtle)]" data-cms-bind={b('category')}>
          {category}
        </span>
        {badgeText && (
          <span class={`text-[10px] uppercase tracking-wider px-2 py-0.5 rounded-md font-bold ${badgeStyles[variant]}`}>
            {badgeText}
          </span>
        )}
      </div>
    </div>
    <h3 class="text-lg font-extrabold text-[var(--ml-text-primary)] group-hover:text-[var(--consulat-link,var(--ml-color-green-500))] transition-colors mb-2 font-title leading-snug" data-cms-bind={b('title')}>
      {title}
    </h3>
    <p class="text-xs md:text-sm text-[var(--ml-text-secondary)] leading-relaxed mb-5" data-cms-bind={b('summary')}>
      {summary}
    </p>
  </div>

  <div>
    <div class="border-t border-[var(--ml-border-subtle)] pt-4 flex items-center justify-between text-xs text-[var(--ml-text-muted)] mb-3">
      <span>Tarif: <strong class="text-[var(--ml-text-primary)] font-semibold" data-cms-bind={b('cost')}>{cost}</strong></span>
      {processingTime && <span>Délai: <strong class="text-[var(--ml-text-primary)] font-semibold" data-cms-bind={b('processingTime')}>{processingTime}</strong></span>}
    </div>
    <div class="text-xs font-bold text-[var(--consulat-link,var(--ml-color-green-500))] group-hover:underline inline-flex items-center gap-1">
      <span>Accéder au service</span>
      <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
    </div>
  </div>
</a>

