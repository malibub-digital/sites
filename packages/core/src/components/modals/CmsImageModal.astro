---
---

<div
  id="ml-cms-image-modal"
  class="ml-modal-overlay hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ml-cms-image-title"
>
  <div class="ml-modal-content">
    <div class="ml-modal-header">
      <div style="display:flex; align-items:center; gap:0.5rem;">
        <i class="ml-icon-image-line ml-icon--xs" style="color: #0284c7;"></i>
        <h3 id="ml-cms-image-title" class="ml-modal-heading">
          Changer l'image
        </h3>
      </div>
      <span class="ml-modal-badge" id="ml-cms-image-bind-key">image</span>
      <button
        type="button"
        id="ml-cms-image-close"
        class="ml-modal-close-btn"
        aria-label="Fermer">&times;</button
      >
    </div>
    <div class="ml-modal-body">
      <div class="ml-form-group">
        <label class="ml-form-label">Aperçu actuel</label>
        <div class="ml-image-preview-box">
          <img id="ml-cms-image-preview-img" src="" alt="Aperçu" />
          <span id="ml-cms-image-preview-empty" class="text-xs text-slate-400">Aucune image</span>
        </div>
      </div>

      <div class="ml-form-group mb-4">
        <label for="ml-cms-image-file-input" class="ml-form-label">Téléverser une image depuis votre ordinateur</label>
        <input
          type="file"
          id="ml-cms-image-file-input"
          accept="image/png, image/jpeg, image/jpg, image/webp, image/svg+xml, image/gif"
          class="ml-form-input ml-cms-input"
          style="width: 100%; font-size: 0.85rem;"
        />
        <p class="text-xs text-slate-500 mt-1" style="font-size: 0.75rem; color: #64748b; margin-top: 0.25rem;">
          Formats acceptés : PNG, JPEG, WEBP, SVG. Le fichier sera stocké dans <code style="background: #f1f5f9; padding: 2px 4px; border-radius: 4px;">/public/images/</code> et commité dans Git.
        </p>
      </div>

      <div class="ml-form-group">
        <label for="ml-cms-image-url-input" class="ml-form-label">Ou saisir directement l'URL de l'image</label>
        <input
          type="text"
          id="ml-cms-image-url-input"
          class="ml-form-input ml-cms-input"
          placeholder="Ex: /images/consulat.png ou https://..."
          style="width: 100%; font-family: inherit; font-size: 0.9rem;"
        />
      </div>
    </div>
    <div class="ml-modal-footer">
      <button
        type="button"
        id="ml-cms-image-cancel"
        class="ml-btn ml-btn--secondary ml-btn--sm">Annuler</button
      >
      <button
        type="button"
        id="ml-cms-image-save"
        class="ml-btn ml-btn--primary ml-btn--sm">Appliquer l'image</button
      >
    </div>
  </div>
</div>
