---
---

<div
  id="ml-cms-edit-popover"
  class="ml-cms-modal-overlay hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ml-cms-popover-title"
>
  <div class="ml-cms-modal-content">
    <div class="ml-cms-modal-header">
      <div style="display:flex; align-items:center; gap:0.5rem;">
        <i class="ml-icon-edit-line ml-icon--xs" style="color: #0284c7;"></i>
        <h3 id="ml-cms-popover-title" class="ml-cms-modal-heading">
          Éditer le contenu
        </h3>
      </div>
      <span class="ml-cms-popover-badge" id="ml-cms-popover-bind-key">field</span>
      <button
        type="button"
        id="ml-cms-popover-close"
        class="ml-cms-popover-close-btn"
        aria-label="Fermer">&times;</button
      >
    </div>
    <div class="ml-cms-modal-body">
      <div class="ml-form-group" id="ml-cms-popover-text-group">
        <label for="ml-cms-popover-text-input" class="ml-form-label" id="ml-cms-popover-text-label"
          >Texte / Valeur de l'élément</label
        >
        <input
          type="text"
          id="ml-cms-popover-text-input"
          class="ml-form-input ml-cms-input"
          style="width: 100%; font-family: inherit; font-size: 0.95rem;"
        />
        <textarea
          id="ml-cms-popover-textarea-input"
          class="ml-form-input ml-cms-textarea hidden"
          rows="4"
          style="width: 100%; font-family: inherit; font-size: 0.95rem; line-height: 1.5;"></textarea>
      </div>

      <div class="ml-form-group hidden" id="ml-cms-popover-href-group" style="margin-top: 0.75rem;">
        <label for="ml-cms-popover-href-input" class="ml-form-label"
          >Lien de la page (URL / Path)</label
        >
        <input
          type="text"
          id="ml-cms-popover-href-input"
          class="ml-form-input ml-cms-input"
          placeholder="Ex: /services/carte-consulaire ou https://..."
          style="width: 100%; font-family: inherit; font-size: 0.95rem;"
        />
      </div>

      <div class="ml-form-group hidden" id="ml-cms-popover-alt-group" style="margin-top: 0.75rem;">
        <label for="ml-cms-popover-alt-input" class="ml-form-label"
          >Texte alternatif / Description (Accessibilité / ARIA)</label
        >
        <input
          type="text"
          id="ml-cms-popover-alt-input"
          class="ml-form-input ml-cms-input"
          placeholder="Texte explicatif du lien ou du bouton"
          style="width: 100%; font-family: inherit; font-size: 0.95rem;"
        />
      </div>
    </div>
    <div class="ml-cms-modal-footer">
      <button
        type="button"
        id="ml-cms-popover-reset"
        class="ml-btn ml-btn--danger ml-btn--sm hidden"
        title="Rétablir la valeur initiale">Rétablir initial</button
      >
      <button
        type="button"
        id="ml-cms-popover-cancel"
        class="ml-btn ml-btn--secondary ml-btn--sm">Annuler</button
      >
      <button
        type="button"
        id="ml-cms-popover-save"
        class="ml-btn ml-btn--primary ml-btn--sm">Appliquer</button
      >
    </div>
  </div>
</div>
