---

<div
  id="ml-cms-drafts-modal"
  class="ml-cms-modal-overlay hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="ml-cms-modal-title"
>
  <div class="ml-cms-modal-content">
    <div class="ml-cms-modal-header">
      <h3 id="ml-cms-modal-title" class="ml-cms-modal-heading">
        Modifications non enregistrées
      </h3>
      <button
        type="button"
        id="ml-cms-modal-close"
        class="ml-cms-popover-close-btn"
        aria-label="Fermer">&times;</button
      >
    </div>
    <div class="ml-cms-modal-body">
      <p class="ml-cms-modal-desc">
        Voici la liste des modifications locales non encore enregistrées :
      </p>
      <div id="ml-cms-modal-list" class="ml-cms-drafts-list"></div>
    </div>
    <div class="ml-cms-modal-footer">
      <button
        type="button"
        id="ml-cms-modal-clear-all"
        class="ml-btn ml-btn--danger ml-btn--sm">Tout réinitialiser</button
      >
      <button
        type="button"
        id="ml-cms-modal-done"
        class="ml-btn ml-btn--secondary ml-btn--sm">Fermer</button
      >
    </div>
  </div>
</div>
