---
import CollectionAddButton from './CollectionAddButton.astro';
import CollectionItemControls from './CollectionItemControls.astro';

interface QuickLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
  primaryAction?: { label: string; href: string };
  secondaryAction?: { label: string; href: string };
  quickLinks?: QuickLink[];
  cmsDataFile?: string;
}

const {
  title,
  subtitle,
  badge = 'Service Officiel',
  primaryAction,
  secondaryAction,
  quickLinks,
  cmsDataFile = 'src/data/pages/home.json',
} = Astro.props;

const b = (field: string) => `${cmsDataFile}::${field}`;
---

<section class="ml-hero bg-gradient-to-br from-[var(--ml-color-river-800)] via-[var(--ml-color-indigo-700)] to-[var(--ml-color-indigo-900)] text-white py-20 px-4 relative overflow-hidden shadow-lg border-b-4 border-[var(--ml-color-mandingue-orange)]">
  <div class="absolute inset-0 opacity-20 bg-[radial-gradient(circle_at_top_right,_var(--tw-gradient-stops))] from-[var(--ml-color-mandingue-500)] via-transparent to-transparent pointer-events-none"></div>

  <div class="ml-container max-w-4xl mx-auto text-center relative z-10">
    {badge && (
      <span class="inline-flex items-center gap-1.5 bg-white/15 text-[var(--ml-color-mandingue-100)] text-xs font-bold px-4 py-1.5 rounded-full uppercase tracking-wider mb-6 border border-white/20 shadow-sm backdrop-blur-md" data-cms-bind={b('hero.badge')}>
        <span class="w-2 h-2 rounded-full bg-[var(--ml-color-mandingue-orange)] animate-pulse"></span>
        {badge}
      </span>
    )}
    <h1 class="text-3xl md:text-5xl font-black font-title tracking-tight mb-5 text-[var(--ml-color-mandingue-100)] drop-shadow-md" data-cms-bind={b('hero.title')}>
      {title}
    </h1>
    {subtitle && (
      <p class="text-lg md:text-xl text-white/95 leading-relaxed mb-10 max-w-2xl mx-auto font-medium" data-cms-bind={b('hero.subtitle')}>
        {subtitle}
      </p>
    )}
    <div class="flex flex-wrap justify-center gap-4 mb-8">
      {primaryAction && (
        <a href={primaryAction.href} class="bg-gradient-to-r from-[var(--ml-color-mandingue-orange)] to-[var(--ml-color-mandingue-500)] hover:from-[var(--ml-color-mandingue-500)] hover:to-[var(--ml-color-mandingue-700)] text-white font-bold px-8 py-3.5 rounded-xl shadow-xl transition-all hover:scale-[1.03] active:scale-[0.98] no-underline inline-flex items-center gap-2">
          <span data-cms-bind={b('hero.primaryAction.label')}>{primaryAction.label}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </a>
      )}
      {secondaryAction && (
        <a href={secondaryAction.href} class="bg-white/15 hover:bg-white/25 text-white font-bold px-8 py-3.5 rounded-xl border border-white/40 backdrop-blur-md transition-all hover:border-white no-underline shadow-md" data-cms-bind={b('hero.secondaryAction.label')}>
          {secondaryAction.label}
        </a>
      )}
    </div>

    {quickLinks && quickLinks.length > 0 && (
      <div class="pt-4 border-t border-white/15 max-w-xl mx-auto" data-cms-collection={`${cmsDataFile}::quickLinks`}>
        <div class="flex flex-wrap items-center justify-center gap-2 text-xs">
          <span class="text-white/70 font-semibold mr-1">Accès rapides :</span>
          {quickLinks.map((link, index) => (
            <div class="quick-link-item" data-cms-item-index={index}>
              <a
                href={link.href}
                class="px-2.5 py-1 rounded-full bg-white/10 hover:bg-white/25 text-white text-[11px] font-bold border border-white/20 no-underline backdrop-blur-sm transition-all"
                data-cms-bind={`${cmsDataFile}::quickLinks.[${index}].label`}
              >
                {link.label}
              </a>
              <CollectionItemControls
                collectionPath={`${cmsDataFile}::quickLinks`}
                index={index}
                isFirst={index === 0}
                isLast={index === quickLinks.length - 1}
              />
            </div>
          ))}
        </div>
        <CollectionAddButton
          collectionPath={`${cmsDataFile}::quickLinks`}
          label="Ajouter un accès rapide"
          defaultData={{ label: "Nouveau lien", href: "/" }}
          class="mt-2"
        />
      </div>
    )}
  </div>
</section>

<style>
  .quick-link-item {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }
</style>
