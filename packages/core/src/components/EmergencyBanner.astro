---
interface Props {
  enabled?: boolean;
  type?: 'info' | 'warning' | 'danger';
  message?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  enabled = false,
  type = 'info',
  message = '',
  ctaLabel,
  ctaHref,
} = Astro.props;

const typeStyles = {
  info: 'bg-[var(--ml-color-river-700)] text-white border-[var(--ml-color-river-500)]',
  warning: 'bg-[var(--ml-color-ambre-sahel)] text-[var(--ml-color-bogolan-nuit)] border-[var(--ml-color-ambre-500)]',
  danger: 'bg-[#dc2626] text-white border-[#b91c1c]',
};

const ctaStyles = {
  info: 'bg-white/20 hover:bg-white/30 text-white border-white/40',
  warning: 'bg-black/10 hover:bg-black/20 text-[var(--ml-color-bogolan-nuit)] border-black/20',
  danger: 'bg-white/20 hover:bg-white/30 text-white border-white/40',
};

const typeIcons = {
  info: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>',
  warning: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>',
  danger: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>',
};
---

{enabled && (
  <div
    class={`emergency-banner border-b-2 px-4 py-3 ${typeStyles[type]}`}
    role="alert"
    aria-live="polite"
  >
    <div class="ml-container flex items-center justify-center gap-3 flex-wrap text-sm font-semibold">
      <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={typeIcons[type]} />
      <span data-cms-bind="siteConfig.emergencyNotice.message">{message}</span>
      {ctaLabel && ctaHref && (
        <a
          href={ctaHref}
          class={`inline-flex items-center gap-1 px-3 py-1 rounded-full border text-xs font-bold no-underline transition-all ${ctaStyles[type]}`}
          data-cms-bind="siteConfig.emergencyNotice.ctaLabel"
        >
          {ctaLabel}
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
        </a>
      )}
    </div>
  </div>
)}

<style>
  .emergency-banner {
    position: sticky;
    top: 0;
    z-index: 60;
    animation: slideDown 0.3s ease-out;
  }
  @keyframes slideDown {
    from { transform: translateY(-100%); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
</style>
