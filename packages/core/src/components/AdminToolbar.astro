---
import { hashSha256 } from "../utils/auth.js";
import CmsEditModal from "./modals/CmsEditModal.astro";
import CmsImageModal from "./modals/CmsImageModal.astro";
import CmsMarkdownModal from "./modals/CmsMarkdownModal.astro";
import CmsDraftsModal from "./modals/CmsDraftsModal.astro";
import CmsResetModal from "./modals/CmsResetModal.astro";
import CmsErrorModal from "./modals/CmsErrorModal.astro";
import CmsCreateContentModal from "./modals/CmsCreateContentModal.astro";

interface Props {
  adminSecret?: string;
  siteId?: string;
  gitEnabled?: boolean;
  scrollable?: boolean;
}

const rawSecret =
  Astro.props.adminSecret ||
  import.meta.env.CMS_ADMIN_SECRET ||
  process.env.CMS_ADMIN_SECRET ||
  "admin123";
const siteId = Astro.props.siteId || "default";
const hashedSecret = await hashSha256(rawSecret);
const scrollable = Astro.props.scrollable ?? true;

const envGitEnabled =
  import.meta.env.CMS_GIT_ENABLED ?? process.env.CMS_GIT_ENABLED;

const gitEnabled =
  Astro.props.gitEnabled !== undefined
    ? Astro.props.gitEnabled
    : String(envGitEnabled).toLowerCase() === "true" ||
      String(envGitEnabled) === "1";
---

<div
  id="ml-admin-toolbar-root"
  data-site-id={siteId}
  data-secret={hashedSecret}
  data-git-enabled={gitEnabled ? "true" : "false"}
>
  <div
    id="ml-admin-bar"
    class={`ml-admin-bar hidden ${scrollable ? "ml-admin-bar-scrollable" : ""}`}
  >
    <div class="ml-admin-bar-container">
      <div class="ml-admin-left">
        <span class="ml-admin-badge ml-badge-admin">
          <span class="ml-status-dot ml-dot-green"></span>
          Admin
        </span>

        <div
          class="ml-segmented-control ml-segmented-control-dark"
          role="radiogroup"
          aria-label="Mode de travail"
        >
          <button
            type="button"
            id="ml-admin-mode-preview"
            class="ml-segment-btn active"
            role="radio"
            aria-checked="true"
            title="Mode Aperçu"
          >
            <i class="ml-icon-eye-line ml-icon--xs"></i>
            <span>Aperçu</span>
          </button>

          <button
            type="button"
            id="ml-admin-mode-edit"
            class="ml-segment-btn"
            role="radio"
            aria-checked="false"
            title="Mode Édition"
          >
            <i class="ml-icon-edit-line ml-icon--xs"></i>
            <span>Édition</span>
          </button>
        </div>

        <button
          type="button"
          id="ml-admin-reset-btn"
          class="ml-admin-reset-btn-discrete hidden"
          title="Réinitialiser toutes les données locales pour afficher l'état exact du serveur"
        >
          <i class="ml-icon-refresh-line ml-icon--xs"></i>
          <span>Réinitialiser</span>
        </button>
      </div>

      <div
        class="ml-admin-right"
        style="display: flex; align-items: center; gap: 0.75rem;"
      >
        <div
          id="ml-admin-notification-zone"
          class="ml-admin-notification-zone ml-notification--info hidden"
          aria-live="polite"
        >
          <span
            id="ml-admin-notification-icon"
            class="ml-icon ml-icon--xs ml-icon-information-line"></span>
          <button
            type="button"
            id="ml-admin-notification-text"
            class="ml-admin-notification-btn"
            title="Voir les détails"></button>
          <button
            type="button"
            id="ml-admin-notification-details-btn"
            class="ml-admin-notification-action-btn hidden"
            title="Voir le détail des erreurs">Détails</button
          >
          <button
            type="button"
            id="ml-admin-notification-dismiss"
            class="ml-admin-notification-close-btn hidden"
            aria-label="Masquer la notification">&times;</button
          >
        </div>

        <button
          type="button"
          id="ml-admin-save-btn"
          class="ml-btn ml-btn--primary ml-btn--sm"
          title="Enregistrer les modifications"
          disabled
        >
          <i class="ml-icon-save-line ml-icon--xs"></i>
          <span>Enregistrer</span>
        </button>

        <button
          type="button"
          id="ml-admin-publish-btn"
          class="ml-btn ml-btn--success ml-btn--sm hidden"
          title="Publier les modifications sur GitHub"
          disabled
        >
          <i class="ml-icon-upload-cloud-line ml-icon--xs"></i>
          <span>Publier</span>
        </button>
      </div>
    </div>
  </div>

  <CmsEditModal />
  <CmsImageModal />
  <CmsMarkdownModal />
  <CmsDraftsModal />
  <CmsResetModal />
  <CmsErrorModal />
  <CmsCreateContentModal />


  <!-- Confirm Delete Modal -->
  <div
    id="ml-cms-confirm-delete-modal"
    class="ml-cms-modal-overlay hidden"
    role="dialog"
    aria-modal="true"
  >
    <div class="ml-cms-modal-content" style="width: 420px;">
      <div class="ml-cms-modal-header">
        <h3 class="ml-cms-modal-heading" style="color: #e11d48; display:flex; align-items:center; gap:0.5rem;">
          <i class="ml-icon-delete-bin-line ml-icon--xs"></i>
          <span>Confirmer la suppression</span>
        </h3>
        <button type="button" id="ml-cms-confirm-delete-close" class="ml-cms-popover-close-btn">&times;</button>
      </div>
      <div class="ml-cms-modal-body">
        <p id="ml-cms-confirm-delete-text" class="ml-cms-modal-desc">
          Êtes-vous sûr de vouloir supprimer cet élément ? Cette action sera enregistrée lors de la sauvegarde.
        </p>
      </div>
      <div class="ml-cms-modal-footer">
        <button type="button" id="ml-cms-confirm-delete-cancel" class="ml-btn ml-btn--secondary ml-btn--sm">
          Annuler
        </button>
        <button type="button" id="ml-cms-confirm-delete-submit" class="ml-btn ml-btn--danger ml-btn--sm">
          <i class="ml-icon-delete-bin-line ml-icon--xs"></i>
          <span>Supprimer</span>
        </button>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .ml-admin-reset-btn-discrete {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(248, 113, 113, 0.85);
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.25);
    cursor: pointer;
    transition: all 0.15s ease;
    text-decoration: none;
    white-space: nowrap;
  }
  .ml-admin-reset-btn-discrete:hover {
    color: #fca5a5;
    background: rgba(239, 68, 68, 0.25);
    border-color: rgba(239, 68, 68, 0.5);
  }

  .ml-cms-modal-header-error {
    background: #fff1f2;
    border-bottom: 1px solid #fecdd3;
  }
  .ml-text-danger {
    color: #e11d48 !important;
  }
  .ml-cms-error-alert-box {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: #fff1f2;
    border: 1px solid #fecdd3;
    color: #9f1239;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    margin-bottom: 0.75rem;
  }
  .ml-cms-error-msg {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    word-break: break-word;
  }
  .ml-cms-error-details-list {
    font-family: monospace;
    font-size: 0.75rem;
    background: #0f172a;
    color: #f8fafc;
    padding: 0.75rem;
    border-radius: 6px;
    max-height: 200px;
    overflow-y: auto;
    white-space: pre-wrap;
  }

  /* Inline CMS Popover styles */
  .ml-cms-popover {
    position: fixed;
    z-index: 10000;
    width: 360px;
    max-width: calc(100vw - 2rem);
    background: #ffffff;
    color: #0f172a;
    border-radius: 12px;
    box-shadow:
      0 10px 25px -5px rgba(0, 0, 0, 0.2),
      0 8px 10px -6px rgba(0, 0, 0, 0.1);
    border: 1px solid #e2e8f0;
    padding: 1rem;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
  }
  .ml-cms-popover-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .ml-cms-popover-badge {
    font-size: 0.7rem;
    font-family: monospace;
    background: #e0f2fe;
    color: #0369a1;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-weight: 600;
  }
  .ml-cms-popover-heading {
    font-size: 0.9rem;
    font-weight: 700;
    margin: 0;
    color: #0f172a;
    flex-grow: 1;
  }
  .ml-cms-popover-close-btn {
    background: transparent;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    color: #64748b;
    line-height: 1;
    padding: 0.2rem 0.4rem;
  }
  .ml-cms-popover-close-btn:hover {
    color: #0f172a;
  }
  .ml-cms-popover-body {
    margin-bottom: 1rem;
  }
  .ml-form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .ml-form-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: #334155;
  }
  .ml-cms-input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.625rem 0.875rem;
    font-size: 0.95rem;
    color: #0f172a;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    margin-top: 0.25rem;
    line-height: 1.5;
  }
  .ml-cms-input:focus {
    border-color: #0284c7;
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
  }
  .ml-cms-textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.625rem 0.875rem;
    font-size: 0.95rem;
    color: #0f172a;
    background-color: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    resize: vertical;
    outline: none;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    margin-top: 0.25rem;
    line-height: 1.5;
  }
  .ml-cms-textarea:focus {
    border-color: #0284c7;
    box-shadow: 0 0 0 3px rgba(2, 132, 199, 0.15);
  }
  .ml-cms-popover-footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .ml-btn {
    padding: 0.35rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    border: 1px solid transparent;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    transition: all 0.15s ease;
  }
  .ml-btn--secondary {
    background: #f1f5f9;
    color: #475569;
    border-color: #cbd5e1;
  }
  .ml-btn--secondary:hover {
    background: #e2e8f0;
  }
  .ml-btn--primary {
    background: #0284c7;
    color: #ffffff;
  }
  .ml-btn--primary:hover {
    background: #0369a1;
  }
  .ml-btn--danger {
    background: #fff1f2;
    color: #e11d48;
    border-color: #fecdd3;
  }
  .ml-btn--danger:hover {
    background: #ffe4e6;
  }
  .ml-btn--success {
    background: #16a34a;
    color: #ffffff;
  }
  .ml-btn--success:hover {
    background: #15803d;
  }

  .ml-btn:disabled,
  .ml-btn[disabled] {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* Drafts & CMS Modals */
  .ml-cms-modal-overlay,
  .ml-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 10005;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .ml-cms-modal-content,
  .ml-modal-content {
    background: #ffffff !important;
    color: #0f172a;
    border-radius: 12px;
    width: 520px;
    max-width: 100%;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
    border: 1px solid #e2e8f0;
  }
  .ml-cms-modal-header,
  .ml-modal-header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f8fafc;
  }
  .ml-cms-modal-heading,
  .ml-modal-heading {
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
    color: #0f172a;
  }
  .ml-cms-modal-body,
  .ml-modal-body {
    padding: 1.25rem;
    overflow-y: auto;
    flex-grow: 1;
    background: #ffffff !important;
    color: #0f172a;
  }
  .ml-cms-modal-desc,
  .ml-modal-desc {
    margin-top: 0;
    margin-bottom: 1rem;
    font-size: 0.85rem;
    color: #64748b;
  }
  .ml-cms-drafts-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .ml-cms-draft-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .ml-cms-draft-key {
    font-size: 0.75rem;
    font-family: monospace;
    color: #0369a1;
    font-weight: 600;
  }
  .ml-cms-draft-val {
    font-size: 0.85rem;
    color: #1e293b;
    background: #ffffff;
    padding: 0.35rem 0.5rem;
    border-radius: 4px;
    border: 1px solid #cbd5e1;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .ml-cms-draft-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.25rem;
  }
  .ml-cms-modal-footer,
  .ml-modal-footer {
    padding: 0.75rem 1.25rem;
    border-top: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #f8fafc;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
  }

  /* Collection Controls Styles */
  :global([data-cms-collection]) {
    position: relative;
  }
  :global([data-cms-item-index]),
  :global([data-cms-file]) {
    position: relative;
  }
  :global(.ml-cms-collection-add-container) {
    display: flex;
    justify-content: center;
    padding: 0.75rem 0;
    margin: 0.5rem 0;
    width: 100%;
  }
  :global(.ml-cms-item-controls-toolbar) {
    display: none;
    align-items: center;
    gap: 0.375rem;
    flex-shrink: 0;
  }
  :global(:root[data-cms-editing="true"]) .ml-cms-item-controls-toolbar,
  :global(body.cms-mode-editing) .ml-cms-item-controls-toolbar {
    display: inline-flex !important;
  }
  :global(.ml-cms-item-btn) {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid #cbd5e1;
    background: #ffffff;
    color: #475569;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
    padding: 0;
    line-height: 1;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }
  :global(.ml-cms-item-btn:hover:not([disabled])) {
    transform: translateY(-1px);
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }
  :global(.ml-cms-item-up:hover:not([disabled])),
  :global(.ml-cms-item-down:hover:not([disabled])) {
    border-color: #0284c7;
    color: #0284c7;
    background: #f0f9ff;
  }
  :global(.ml-cms-item-delete:hover:not([disabled])) {
    border-color: #e11d48;
    color: #e11d48;
    background: #fff1f2;
  }
  :global(.ml-cms-item-btn[disabled]) {
    opacity: 0.3;
    cursor: not-allowed;
    border-color: #e2e8f0;
    color: #94a3b8;
    background: #f8fafc;
    box-shadow: none;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 767px) {
    .ml-admin-bar-container {
      padding: 0.4rem 0.5rem;
      gap: 0.35rem;
      max-width: 100%;
      width: 100%;
      box-sizing: border-box;
    }
    .ml-admin-left {
      gap: 0.35rem;
      flex-shrink: 0;
    }
    .ml-badge-admin {
      padding: 0.25rem 0.35rem;
    }
    .ml-badge-admin span:not(.ml-status-dot) {
      display: none;
    }
    .ml-segmented-control {
      padding: 2px;
      gap: 2px;
    }
    .ml-segment-btn {
      padding: 0.3rem 0.45rem;
      font-size: 0.75rem;
      gap: 0.25rem;
    }
    .ml-admin-right {
      gap: 0.35rem !important;
      flex-shrink: 0;
    }
    .ml-btn {
      padding: 0.35rem 0.55rem;
      font-size: 0.75rem;
      gap: 0.25rem;
      white-space: nowrap;
    }
    .ml-btn span {
      display: inline-block;
    }

    .ml-admin-notification-zone {
      position: absolute;
      bottom: calc(100% + 10px);
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 20px);
      max-width: 480px;
      background: rgba(15, 23, 42, 0.96);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding: 0.5rem 0.75rem;
      border-radius: 10px;
      box-shadow:
        0 10px 25px -5px rgba(0, 0, 0, 0.4),
        0 4px 6px -2px rgba(0, 0, 0, 0.2);
      z-index: 10000;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      box-sizing: border-box;
      animation: ml-slide-up 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .ml-admin-notification-btn {
      white-space: normal;
      word-break: break-word;
      text-align: left;
      flex: 1;
      min-width: 0;
    }
  }

  @keyframes ml-slide-up {
    from {
      opacity: 0;
      transform: translate(-50%, 8px);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  @media (max-width: 380px) {
    .ml-admin-bar-container {
      padding: 0.35rem 0.25rem;
      gap: 0.25rem;
    }
    .ml-segment-btn {
      padding: 0.25rem 0.35rem;
      font-size: 0.7rem;
    }
    .ml-btn {
      padding: 0.3rem 0.45rem;
      font-size: 0.7rem;
    }
  }

  :global(:root[data-cms-editing="true"]) {
    scroll-padding-top: 0;
  }
</style>

<script>
  import { getAdminCookieToken } from "../utils/auth.js";
  import {
    cmsDraftStore,
    cmsSavedStore,
    cmsOperationsStore,
    updateDraft,
    removeDraft,
    clearDrafts,
    addOperation,
    removeOperation,
    clearOperations,
    addSavedChanges,
    removeSaved,
    clearSavedChanges,
    resetAllCmsState,
  } from "../store/cms.js";

  const STORAGE_KEY_UNPUBLISHED = "cms_has_unpublished_changes";

  function initAdminToolbar() {
    const root = document.getElementById("ml-admin-toolbar-root");
    if (!root) return;

    const bar = document.getElementById("ml-admin-bar");
    const modeEditBtn = document.getElementById("ml-admin-mode-edit");
    const modePreviewBtn = document.getElementById("ml-admin-mode-preview");
    const saveBtn = document.getElementById("ml-admin-save-btn");
    const publishBtn = document.getElementById("ml-admin-publish-btn");
    const resetBtn = document.getElementById("ml-admin-reset-btn");

    const notificationZone = document.getElementById(
      "ml-admin-notification-zone",
    );
    const notificationIcon = document.getElementById(
      "ml-admin-notification-icon",
    );
    const notificationText = document.getElementById(
      "ml-admin-notification-text",
    ) as HTMLButtonElement | null;
    const notificationDetailsBtn = document.getElementById(
      "ml-admin-notification-details-btn",
    ) as HTMLButtonElement | null;
    const notificationDismissBtn = document.getElementById(
      "ml-admin-notification-dismiss",
    ) as HTMLButtonElement | null;

    const popover = document.getElementById("ml-cms-edit-popover");
    const popoverBindKey = document.getElementById("ml-cms-popover-bind-key");
    const popoverTextInput = document.getElementById(
      "ml-cms-popover-text-input",
    ) as HTMLInputElement | null;
    const popoverTextareaInput = document.getElementById(
      "ml-cms-popover-textarea-input",
    ) as HTMLTextAreaElement | null;
    const popoverHrefGroup = document.getElementById("ml-cms-popover-href-group");
    const popoverHrefInput = document.getElementById(
      "ml-cms-popover-href-input",
    ) as HTMLInputElement | null;
    const popoverClose = document.getElementById("ml-cms-popover-close");
    const popoverCancel = document.getElementById("ml-cms-popover-cancel");
    const popoverReset = document.getElementById("ml-cms-popover-reset");
    const popoverSave = document.getElementById("ml-cms-popover-save");

    const draftsModal = document.getElementById("ml-cms-drafts-modal");
    const draftsModalList = document.getElementById("ml-cms-modal-list");
    const draftsModalClose = document.getElementById("ml-cms-modal-close");
    const draftsModalDone = document.getElementById("ml-cms-modal-done");
    const draftsModalClearAll = document.getElementById(
      "ml-cms-modal-clear-all",
    );

    const resetModal = document.getElementById("ml-cms-reset-modal");
    const resetModalClose = document.getElementById("ml-cms-reset-close");
    const resetModalCancel = document.getElementById("ml-cms-reset-cancel");
    const resetModalConfirm = document.getElementById("ml-cms-reset-confirm");

    const errorModal = document.getElementById("ml-cms-error-modal");
    const errorModalTitle = document.getElementById("ml-cms-error-title");
    const errorModalMsg = document.getElementById("ml-cms-error-message");
    const errorModalDetails = document.getElementById(
      "ml-cms-error-details-list",
    );
    const errorModalClose = document.getElementById("ml-cms-error-close");
    const errorModalDone = document.getElementById("ml-cms-error-done");

    const createContentModal = document.getElementById("ml-cms-create-content-modal");
    const createContentTitle = document.getElementById("ml-create-content-title") as HTMLInputElement | null;
    const createContentCategory = document.getElementById("ml-create-content-category") as HTMLInputElement | null;
    const createContentCollection = document.getElementById("ml-create-content-collection") as HTMLInputElement | null;
    const createContentClose = document.getElementById("ml-cms-create-content-close");
    const createContentCancel = document.getElementById("ml-cms-create-content-cancel");
    const createContentSubmit = document.getElementById("ml-cms-create-content-submit");

    const confirmDeleteModal = document.getElementById("ml-cms-confirm-delete-modal");
    const confirmDeleteText = document.getElementById("ml-cms-confirm-delete-text");
    const confirmDeleteClose = document.getElementById("ml-cms-confirm-delete-close");
    const confirmDeleteCancel = document.getElementById("ml-cms-confirm-delete-cancel");
    const confirmDeleteSubmit = document.getElementById("ml-cms-confirm-delete-submit");

    const expectedHash = root.getAttribute("data-secret") || "";
    const isGitEnabled = root.getAttribute("data-git-enabled") === "true";
    let activeTargetElement: HTMLElement | null = null;
    let pendingDeleteTarget: { type: 'array' | 'file'; collectionPath: string; index?: number; slug?: string } | null = null;
    let lastErrorData: {
      title: string;
      message: string;
      details?: string[];
    } | null = null;

    function notify(
      message: string,
      type: "info" | "success" | "error" = "info",
      details?: string[],
    ) {
      if (!notificationZone || !notificationText) return;

      notificationZone.className = `ml-admin-notification-zone ml-notification--${type}`;
      notificationText.textContent = message;

      if (notificationIcon) {
        notificationIcon.className = `ml-icon ml-icon--xs ${
          type === "error"
            ? "ml-icon-alert-fill"
            : type === "success"
              ? "ml-icon-checkbox-circle-fill"
              : "ml-icon-information-line"
        }`;
      }

      if (type === "error") {
        lastErrorData = { title: "Échec de l'opération", message, details };
        if (notificationDetailsBtn)
          notificationDetailsBtn.classList.remove("hidden");
        if (notificationDismissBtn)
          notificationDismissBtn.classList.remove("hidden");
      } else if (type === "success") {
        lastErrorData = null;
        if (notificationDetailsBtn)
          notificationDetailsBtn.classList.remove("hidden");
        if (notificationDismissBtn)
          notificationDismissBtn.classList.remove("hidden");
      } else {
        lastErrorData = null;
        if (notificationDetailsBtn)
          notificationDetailsBtn.classList.add("hidden");
        if (notificationDismissBtn)
          notificationDismissBtn.classList.add("hidden");
      }

      notificationZone.classList.remove("hidden");
    }

    function setSaveLoading(loading: boolean) {
      if (!saveBtn) return;
      (saveBtn as HTMLButtonElement).disabled = loading;
      if (loading) {
        saveBtn.innerHTML = `<i class="ml-icon-refresh-line ml-spin ml-icon--xs"></i><span>Enregistrement...</span>`;
      } else {
        saveBtn.innerHTML = `<i class="ml-icon-save-line ml-icon--xs"></i><span>Enregistrer</span>`;
      }
    }

    function setPublishLoading(loading: boolean) {
      if (!publishBtn) return;
      (publishBtn as HTMLButtonElement).disabled = loading;
      if (loading) {
        publishBtn.innerHTML = `<i class="ml-icon-refresh-line ml-spin ml-icon--xs"></i><span>Publication...</span>`;
      } else {
        publishBtn.innerHTML = `<i class="ml-icon-upload-cloud-line ml-icon--xs"></i><span>Publier</span>`;
      }
    }

    function openErrorModal() {
      if (!errorModal || !lastErrorData) return;
      if (errorModalTitle) errorModalTitle.textContent = lastErrorData.title;
      if (errorModalMsg) errorModalMsg.textContent = lastErrorData.message;

      if (errorModalDetails) {
        if (lastErrorData.details && lastErrorData.details.length > 0) {
          errorModalDetails.textContent = lastErrorData.details.join("\n");
          errorModalDetails.classList.remove("hidden");
        } else {
          errorModalDetails.classList.add("hidden");
        }
      }

      errorModal.classList.remove("hidden");
    }

    function closeErrorModal() {
      errorModal?.classList.add("hidden");
    }

    function openResetModal() {
      resetModal?.classList.remove("hidden");
    }

    function closeResetModal() {
      resetModal?.classList.add("hidden");
    }

    function openCreateContentModal(collectionName: string) {
      if (createContentCollection) createContentCollection.value = collectionName;
      if (createContentTitle) createContentTitle.value = "";
      if (createContentCategory) createContentCategory.value = "";
      createContentModal?.classList.remove("hidden");
    }

    function closeCreateContentModal() {
      createContentModal?.classList.add("hidden");
    }

    function openConfirmDeleteModal(target: { type: 'array' | 'file'; collectionPath: string; index?: number; slug?: string }) {
      pendingDeleteTarget = target;
      if (confirmDeleteText) {
        confirmDeleteText.textContent = target.type === 'file'
          ? `Êtes-vous sûr de vouloir supprimer l'article "${target.slug}" ?`
          : `Êtes-vous sûr de vouloir supprimer cet élément de la liste ?`;
      }
      confirmDeleteModal?.classList.remove("hidden");
    }

    function closeConfirmDeleteModal() {
      confirmDeleteModal?.classList.add("hidden");
      pendingDeleteTarget = null;
    }

    function updateToolbarButtonsState() {
      const drafts = cmsDraftStore.get();
      const ops = cmsOperationsStore.get();
      const hasDrafts = Object.keys(drafts).length > 0;
      const hasOps = ops.length > 0;
      const hasChanges = hasDrafts || hasOps;
      const hasUnpublished =
        localStorage.getItem(STORAGE_KEY_UNPUBLISHED) === "true";

      if (saveBtn) {
        (saveBtn as HTMLButtonElement).disabled = !hasChanges;
      }

      if (publishBtn) {
        (publishBtn as HTMLButtonElement).disabled =
          !isGitEnabled || hasChanges || !hasUnpublished;
      }

      if (hasChanges) {
        const count = Object.keys(drafts).length + ops.length;
        const s = count > 1 ? "s" : "";
        notify(`${count} modification${s} non enregistrée${s}`, "info");
      } else if (hasUnpublished && isGitEnabled) {
        notify("Modifications enregistrées. Prêt pour publication.", "info");
      } else if (!lastErrorData) {
        notificationZone?.classList.add("hidden");
      }
    }

    function renderDraftsModal() {
      if (!draftsModalList) return;
      const drafts = cmsDraftStore.get();
      const keys = Object.keys(drafts);

      if (keys.length === 0) {
        draftsModalList.innerHTML = `<p style="font-size:0.85rem; color:#64748b; margin:0;">Aucune modification en cours.</p>`;
        return;
      }

      draftsModalList.innerHTML = "";
      keys.forEach((key) => {
        const item = document.createElement("div");
        item.className = "ml-cms-draft-item";

        const keySpan = document.createElement("div");
        keySpan.className = "ml-cms-draft-key";
        keySpan.textContent = key;

        const valDiv = document.createElement("div");
        valDiv.className = "ml-cms-draft-val";
        valDiv.textContent = drafts[key];

        const actionsDiv = document.createElement("div");
        actionsDiv.className = "ml-cms-draft-actions";

        const removeBtn = document.createElement("button");
        removeBtn.type = "button";
        removeBtn.className = "ml-btn ml-btn--danger ml-btn--sm";
        removeBtn.textContent = "Rétablir initial";
        removeBtn.addEventListener("click", () => {
          removeDraft(key);
          renderDraftsModal();
        });

        actionsDiv.appendChild(removeBtn);
        item.appendChild(keySpan);
        item.appendChild(valDiv);
        item.appendChild(actionsDiv);
        draftsModalList.appendChild(item);
      });
    }

    function openDraftsModal() {
      renderDraftsModal();
      draftsModal?.classList.remove("hidden");
    }

    function closeDraftsModal() {
      draftsModal?.classList.add("hidden");
    }

    function isMultilineField(el: HTMLElement, bindKey: string): boolean {
      const typeAttr = el.getAttribute("data-cms-type");
      if (typeAttr === "multiline" || typeAttr === "textarea") return true;
      if (typeAttr === "input" || typeAttr === "text") return false;

      const currentVal = el.textContent?.trim() || "";
      if (currentVal.includes("\n")) return true;

      const lowerKey = bindKey.toLowerCase();
      const multilineKeywords = ["content", "body", "description", "summary", "answer", "markdown", "message"];
      return multilineKeywords.some((kw) => lowerKey.includes(kw));
    }

    function cacheOriginalValues() {
      const elements = document.querySelectorAll("[data-cms-bind]");
      elements.forEach((el) => {
        if (!el.hasAttribute("data-cms-original")) {
          const cmsType = el.getAttribute("data-cms-type") || (el.tagName === "IMG" ? "image" : "text");
          if (cmsType === "image" && (el instanceof HTMLImageElement || el.tagName === "IMG")) {
            el.setAttribute("data-cms-original", (el as HTMLImageElement).src || el.getAttribute("src") || "");
          } else if (cmsType === "markdown") {
            el.setAttribute("data-cms-original", el.innerHTML || "");
          } else {
            el.setAttribute("data-cms-original", el.textContent?.trim() || "");
          }
        }
        const hrefPath = el.getAttribute("data-cms-bind-href");
        if (hrefPath && !el.hasAttribute("data-cms-original-href")) {
          el.setAttribute("data-cms-original-href", el.getAttribute("href") || "");
        }
      });
    }

    function renderCollectionControls() {
      // Les boutons d'ajout sont gérés par le composant CollectionAddButton
    }

    function syncDraftsWithDOM() {
      cacheOriginalValues();
      const drafts = cmsDraftStore.get();
      const saved = cmsSavedStore.get();
      const elements = document.querySelectorAll("[data-cms-bind]");

      elements.forEach((el) => {
        const path = el.getAttribute("data-cms-bind");
        const original = el.getAttribute("data-cms-original") || "";

        const cmsType = el.getAttribute("data-cms-type") || (el.tagName === "IMG" ? "image" : "text");
        if (path && (drafts[path] !== undefined || saved[path] !== undefined)) {
          const val = drafts[path] !== undefined ? drafts[path] : saved[path];
          if (cmsType === "image" && (el instanceof HTMLImageElement || el.tagName === "IMG")) {
            (el as HTMLImageElement).src = val;
          } else if (cmsType === "markdown") {
            el.innerHTML = val;
          } else {
            el.textContent = val;
          }

          if (drafts[path] !== undefined) {
            el.setAttribute("data-cms-has-draft", "true");
            el.removeAttribute("data-cms-has-saved");
          } else {
            el.removeAttribute("data-cms-has-draft");
            el.setAttribute("data-cms-has-saved", "true");
          }
        } else {
          if (cmsType === "image" && (el instanceof HTMLImageElement || el.tagName === "IMG")) {
            const originalSrc = el.getAttribute("data-cms-original") || "";
            if (originalSrc) (el as HTMLImageElement).src = originalSrc;
          } else if (cmsType === "markdown") {
            const originalHtml = el.getAttribute("data-cms-original") || "";
            if (originalHtml) el.innerHTML = originalHtml;
          } else {
            el.textContent = original;
          }
          el.removeAttribute("data-cms-has-draft");
          el.removeAttribute("data-cms-has-saved");
        }

        const hrefPath = el.getAttribute("data-cms-bind-href");
        if (hrefPath) {
          const originalHref = el.getAttribute("data-cms-original-href") || el.getAttribute("href") || "";
          if (drafts[hrefPath] !== undefined) {
            el.setAttribute("href", drafts[hrefPath]);
          } else if (saved[hrefPath] !== undefined) {
            el.setAttribute("href", saved[hrefPath]);
          } else {
            el.setAttribute("href", originalHref);
          }
        }
      });

      renderCollectionControls();
      updateToolbarButtonsState();
    }

    function setEditingMode(active: boolean) {
      document.body.classList.toggle("cms-mode-editing", active);
      document.documentElement.setAttribute("data-cms-editing", String(active));

      if (active) {
        modeEditBtn?.classList.add("active");
        modeEditBtn?.setAttribute("aria-checked", "true");
        modePreviewBtn?.classList.remove("active");
        modePreviewBtn?.setAttribute("aria-checked", "false");
      } else {
        modeEditBtn?.classList.remove("active");
        modeEditBtn?.setAttribute("aria-checked", "false");
        modePreviewBtn?.classList.add("active");
        modePreviewBtn?.setAttribute("aria-checked", "true");
        closePopover();
      }

      renderCollectionControls();

      document.dispatchEvent(
        new CustomEvent("cms:editing-toggled", {
          detail: { isEditing: active },
        }),
      );
    }

    function checkAuthState() {
      const token = getAdminCookieToken();
      const isAuthenticated =
        token !== null &&
        token.length > 0 &&
        (!expectedHash || token === expectedHash);

      if (isAuthenticated) {
        bar?.classList.remove("hidden");
        document.body.classList.add("ml-admin-logged-in");
        saveBtn?.classList.remove("hidden");
        resetBtn?.classList.remove("hidden");
        if (isGitEnabled) {
          publishBtn?.classList.remove("hidden");
        } else {
          publishBtn?.classList.add("hidden");
        }
        setEditingMode(false);
      } else {
        bar?.classList.add("hidden");
        document.body.classList.remove("ml-admin-logged-in");
        saveBtn?.classList.add("hidden");
        publishBtn?.classList.add("hidden");
        resetBtn?.classList.add("hidden");
        setEditingMode(false);
        resetAllCmsState();
        localStorage.removeItem(STORAGE_KEY_UNPUBLISHED);
      }
    }

    const imageModal = document.getElementById("ml-cms-image-modal");
    const imageBindKey = document.getElementById("ml-cms-image-bind-key");
    const imagePreviewImg = document.getElementById("ml-cms-image-preview-img") as HTMLImageElement | null;
    const imagePreviewEmpty = document.getElementById("ml-cms-image-preview-empty");
    const imageFileInput = document.getElementById("ml-cms-image-file-input") as HTMLInputElement | null;
    const imageUrlInput = document.getElementById("ml-cms-image-url-input") as HTMLInputElement | null;
    const imageClose = document.getElementById("ml-cms-image-close");
    const imageCancel = document.getElementById("ml-cms-image-cancel");
    const imageSave = document.getElementById("ml-cms-image-save");

    const markdownModal = document.getElementById("ml-cms-markdown-modal");
    const markdownBindKey = document.getElementById("ml-cms-markdown-bind-key");
    const markdownClose = document.getElementById("ml-cms-markdown-close");
    const markdownCancel = document.getElementById("ml-cms-markdown-cancel");
    const markdownSave = document.getElementById("ml-cms-markdown-save");
    const tiptapContainer = document.getElementById("ml-tiptap-editor-container");

    async function closePopover() {
      if (activeTargetElement) {
        activeTargetElement.removeAttribute("data-cms-active");
        const bindKey = activeTargetElement.getAttribute("data-cms-bind");
        if (bindKey) {
          const token = getAdminCookieToken();
          try {
            await fetch("/api/cms/lock", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                ...(token ? { Authorization: `Bearer ${token}` } : {}),
              },
              body: JSON.stringify({ resourceId: bindKey, action: "release" }),
            });
          } catch {}
        }
      }
      popover?.classList.add("hidden");
      imageModal?.classList.add("hidden");
      markdownModal?.classList.add("hidden");
      activeTargetElement = null;
    }

    async function openPopover(el: HTMLElement, event: MouseEvent) {
      if (activeTargetElement) {
        activeTargetElement.removeAttribute("data-cms-active");
      }
      const bindKey = el.getAttribute("data-cms-bind") || "element";
      const hrefBindKey = el.getAttribute("data-cms-bind-href");
      const altBindKey = el.getAttribute("data-cms-bind-alt");
      const cmsType = el.getAttribute("data-cms-type") || (el.tagName === "IMG" ? "image" : "text");
      const token = getAdminCookieToken();

      try {
        const lockRes = await fetch("/api/cms/lock", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            ...(token ? { Authorization: `Bearer ${token}` } : {}),
          },
          body: JSON.stringify({ resourceId: bindKey, action: "acquire" }),
        });

        if (lockRes.status === 423) {
          const lockData = await lockRes.json();
          notify(
            `⚠️ Élément actuellement en cours d'édition par ${lockData.holderName || "un autre administrateur"}.`,
            "info",
          );
          return;
        }
      } catch (err: any) {
        console.warn("Échec de la vérification de verrou:", err);
      }

      activeTargetElement = el;
      activeTargetElement.setAttribute("data-cms-active", "true");
      const drafts = cmsDraftStore.get();
      const saved = cmsSavedStore.get();
      const hasDraft = bindKey in drafts || (hrefBindKey ? hrefBindKey in drafts : false);
      const hasSaved = bindKey in saved || (hrefBindKey ? hrefBindKey in saved : false);

      if (cmsType === "image") {
        if (imageBindKey) imageBindKey.textContent = bindKey;
        const currentSrc = drafts[bindKey] ?? saved[bindKey] ?? (el instanceof HTMLImageElement ? el.src : el.getAttribute("src") || "");
        if (imageUrlInput) imageUrlInput.value = currentSrc;
        if (imagePreviewImg) {
          if (currentSrc) {
            imagePreviewImg.src = currentSrc;
            imagePreviewImg.style.display = "block";
            if (imagePreviewEmpty) imagePreviewEmpty.style.display = "none";
          } else {
            imagePreviewImg.style.display = "none";
            if (imagePreviewEmpty) imagePreviewEmpty.style.display = "block";
          }
        }
        imageModal?.classList.remove("hidden");
        return;
      }

      if (cmsType === "markdown") {
        if (markdownBindKey) markdownBindKey.textContent = bindKey;
        const currentValue = drafts[bindKey] ?? saved[bindKey] ?? el.innerHTML ?? "";
        if (tiptapContainer) {
          tiptapContainer.innerHTML = currentValue;
          tiptapContainer.contentEditable = "true";
        }
        markdownModal?.classList.remove("hidden");
        return;
      }

      if (popoverBindKey) popoverBindKey.textContent = hrefBindKey ? `${bindKey} (+href)` : bindKey;

      const currentValue = drafts[bindKey] ?? saved[bindKey] ?? el.textContent?.trim() ?? "";
      const isMulti = isMultilineField(el, bindKey);

      if (isMulti) {
        popoverTextInput?.classList.add("hidden");
        popoverTextareaInput?.classList.remove("hidden");
        if (popoverTextareaInput) popoverTextareaInput.value = currentValue;
      } else {
        popoverTextareaInput?.classList.add("hidden");
        popoverTextInput?.classList.remove("hidden");
        if (popoverTextInput) popoverTextInput.value = currentValue;
      }

      if (hrefBindKey && popoverHrefGroup) {
        popoverHrefGroup.classList.remove("hidden");
        const currentHref = drafts[hrefBindKey] ?? saved[hrefBindKey] ?? el.getAttribute("href") ?? "";
        if (popoverHrefInput) popoverHrefInput.value = currentHref;
      } else if (popoverHrefGroup) {
        popoverHrefGroup.classList.add("hidden");
      }

      if (hasDraft || hasSaved) {
        popoverReset?.classList.remove("hidden");
      } else {
        popoverReset?.classList.add("hidden");
      }

      if (popover) {
        popover.classList.remove("hidden");
        const targetInput = isMulti ? popoverTextareaInput : popoverTextInput;
        targetInput?.focus();
      }
    }

    async function handleElementClick(event: MouseEvent) {
      if (document.documentElement.getAttribute("data-cms-editing") !== "true")
        return;
      const target = (event.target as HTMLElement).closest(
        "[data-cms-bind]",
      ) as HTMLElement | null;
      if (!target) return;

      if (
        target.children.length > 0 &&
        Array.from(target.children).some(
          (child) => !child.classList.contains("ml-tricolor-bar"),
        )
      ) {
        return;
      }

      event.preventDefault();
      event.stopPropagation();
      await openPopover(target, event);
    }

    function resetElement() {
      if (!activeTargetElement) return;
      const bindPath = activeTargetElement.getAttribute("data-cms-bind");
      const hrefBindPath = activeTargetElement.getAttribute("data-cms-bind-href");

      if (bindPath) {
        removeDraft(bindPath);
        removeSaved(bindPath);
      }
      if (hrefBindPath) {
        removeDraft(hrefBindPath);
        removeSaved(hrefBindPath);
      }
      closePopover();
    }

    function applyChange() {
      if (!activeTargetElement) return;
      const bindPath = activeTargetElement.getAttribute("data-cms-bind");
      const hrefBindPath = activeTargetElement.getAttribute("data-cms-bind-href");
      const isMulti = isMultilineField(activeTargetElement, bindPath || "");

      const activeTextInput = isMulti ? popoverTextareaInput : popoverTextInput;
      const newValue = activeTextInput?.value.trim() ?? "";
      const originalValue = activeTargetElement.getAttribute("data-cms-original") || "";

      if (bindPath) {
        if (newValue === originalValue) {
          removeDraft(bindPath);
          removeSaved(bindPath);
        } else {
          updateDraft(bindPath, newValue);
        }
      }

      if (hrefBindPath && popoverHrefInput) {
        const newHrefValue = popoverHrefInput.value.trim();
        const originalHrefValue =
          activeTargetElement.getAttribute("data-cms-original-href") ||
          activeTargetElement.getAttribute("href") ||
          "";
        if (newHrefValue === originalHrefValue) {
          removeDraft(hrefBindPath);
          removeSaved(hrefBindPath);
        } else {
          updateDraft(hrefBindPath, newHrefValue);
        }
      }

      closePopover();
    }

    cmsDraftStore.subscribe(() => {
      syncDraftsWithDOM();
    });

    cmsSavedStore.subscribe(() => {
      syncDraftsWithDOM();
    });

    cmsOperationsStore.subscribe(() => {
      syncDraftsWithDOM();
    });

    saveBtn?.addEventListener("click", async () => {
      const drafts = cmsDraftStore.get();
      const operations = cmsOperationsStore.get();
      if (Object.keys(drafts).length === 0 && operations.length === 0) return;

      const token = getAdminCookieToken();
      setSaveLoading(true);
      notify("Enregistrement en cours...", "info");

      try {
        const response = await fetch("/api/cms/save", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            ...(token ? { Authorization: `Bearer ${token}` } : {}),
          },
          body: JSON.stringify({ drafts, operations }),
        });

        const resData = await response.json();
        setSaveLoading(false);

        if (response.ok && resData.success) {
          addSavedChanges(drafts);
          clearDrafts();
          clearOperations();
          localStorage.setItem(STORAGE_KEY_UNPUBLISHED, "true");
          updateToolbarButtonsState();
          notify("Modifications enregistrées avec succès !", "success");
          setTimeout(() => {
            if (localStorage.getItem(STORAGE_KEY_UNPUBLISHED) === "true") {
              notify(
                "Modifications enregistrées. Prêt pour publication.",
                "info",
              );
            }
          }, 3000);
        } else {
          notify(
            `Erreur: ${resData.message || "Échec de la sauvegarde."}`,
            "error",
            resData.errors,
          );
          updateToolbarButtonsState();
        }
      } catch (err: any) {
        setSaveLoading(false);
        notify(
          `Erreur réseau: ${err.message || "Impossible de contacter le serveur."}`,
          "error",
          [err.message],
        );
        updateToolbarButtonsState();
      }

      document.dispatchEvent(
        new CustomEvent("cms:save-requested", { detail: { drafts, operations } }),
      );
    });

    publishBtn?.addEventListener("click", async () => {
      const drafts = cmsDraftStore.get();
      const operations = cmsOperationsStore.get();
      if (
        Object.keys(drafts).length > 0 ||
        operations.length > 0 ||
        localStorage.getItem(STORAGE_KEY_UNPUBLISHED) !== "true"
      )
        return;

      const token = getAdminCookieToken();
      setPublishLoading(true);
      notify("Publication sur GitHub en cours...", "info");

      try {
        const response = await fetch("/api/cms/publish", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            ...(token ? { Authorization: `Bearer ${token}` } : {}),
          },
        });

        const resData = await response.json();
        setPublishLoading(false);

        if (response.ok && resData.success) {
          localStorage.removeItem(STORAGE_KEY_UNPUBLISHED);
          updateToolbarButtonsState();
          notify(
            resData.message ||
              "Modifications publiées sur GitHub avec succès !",
            "success",
          );
          setTimeout(() => {
            notificationZone?.classList.add("hidden");
          }, 4000);
        } else {
          notify(
            resData.message || "Échec de la publication sur GitHub.",
            "error",
            resData.errors,
          );
          updateToolbarButtonsState();
        }
      } catch (err: any) {
        setPublishLoading(false);
        notify(
          `Erreur réseau: ${err.message || "Impossible de contacter le serveur."}`,
          "error",
          [err.message],
        );
        updateToolbarButtonsState();
      }
    });

    createContentClose?.addEventListener("click", closeCreateContentModal);
    createContentCancel?.addEventListener("click", closeCreateContentModal);
    createContentSubmit?.addEventListener("click", () => {
      const collection = createContentCollection?.value || "actualites";
      const title = createContentTitle?.value.trim() || "Nouveau document";
      const category = createContentCategory?.value.trim() || "Général";
      const slug = title
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, "-")
        .replace(/(^-|-$)/g, "");

      addOperation({
        type: "CREATE_CONTENT_FILE",
        collection,
        slug: slug || "nouveau-document",
        frontmatter: { title, category, date: new Date().toISOString().split("T")[0] },
        content: `# ${title}\n\nSaisissez le contenu du document ici.`,
      });

      closeCreateContentModal();
      notify(`Document "${title}" prêt à être créé. N'oubliez pas d'enregistrer.`, "info");
    });

    confirmDeleteClose?.addEventListener("click", closeConfirmDeleteModal);
    confirmDeleteCancel?.addEventListener("click", closeConfirmDeleteModal);
    confirmDeleteSubmit?.addEventListener("click", () => {
      if (!pendingDeleteTarget) return;
      if (pendingDeleteTarget.type === "file" && pendingDeleteTarget.slug) {
        addOperation({
          type: "DELETE_CONTENT_FILE",
          collection: pendingDeleteTarget.collectionPath,
          slug: pendingDeleteTarget.slug,
        });
        notify(`Article marqué pour suppression. N'oubliez pas d'enregistrer.`, "info");
      } else if (pendingDeleteTarget.type === "array" && pendingDeleteTarget.index !== undefined) {
        addOperation({
          type: "DELETE_ARRAY_ITEM",
          arrayPath: pendingDeleteTarget.collectionPath,
          index: pendingDeleteTarget.index,
        });
        notify(`Élément marqué pour suppression. N'oubliez pas d'enregistrer.`, "info");
      }
      closeConfirmDeleteModal();
    });

    resetBtn?.addEventListener("click", openResetModal);
    resetModalClose?.addEventListener("click", closeResetModal);
    resetModalCancel?.addEventListener("click", closeResetModal);
    resetModalConfirm?.addEventListener("click", () => {
      resetAllCmsState();
      localStorage.removeItem(STORAGE_KEY_UNPUBLISHED);
      syncDraftsWithDOM();
      closeResetModal();
      notify("Version du serveur rechargée avec succès.", "info");
      setTimeout(() => {
        notificationZone?.classList.add("hidden");
      }, 3000);
    });

    notificationText?.addEventListener("click", () => {
      if (lastErrorData) {
        openErrorModal();
        return;
      }
      const drafts = cmsDraftStore.get();
      if (Object.keys(drafts).length > 0) {
        openDraftsModal();
      }
    });

    notificationDetailsBtn?.addEventListener("click", openErrorModal);
    notificationDismissBtn?.addEventListener("click", () => {
      notificationZone?.classList.add("hidden");
    });

    errorModalClose?.addEventListener("click", closeErrorModal);
    errorModalDone?.addEventListener("click", closeErrorModal);

    draftsModalClose?.addEventListener("click", closeDraftsModal);
    draftsModalDone?.addEventListener("click", closeDraftsModal);
    draftsModalClearAll?.addEventListener("click", () => {
      openResetModal();
      closeDraftsModal();
    });

    imageClose?.addEventListener("click", closePopover);
    imageCancel?.addEventListener("click", closePopover);
    imageSave?.addEventListener("click", async () => {
      if (!activeTargetElement) return;
      const bindPath = activeTargetElement.getAttribute("data-cms-bind");
      if (!bindPath) return;

      let finalUrl = imageUrlInput?.value.trim() || "";

      if (imageFileInput && imageFileInput.files && imageFileInput.files.length > 0) {
        const file = imageFileInput.files[0];
        const formData = new FormData();
        formData.append("file", file);
        formData.append("dir", "images");

        const token = getAdminCookieToken();
        notify("Téléversement de l'image...", "info");

        try {
          const res = await fetch("/api/cms/upload", {
            method: "POST",
            headers: {
              ...(token ? { Authorization: `Bearer ${token}` } : {}),
            },
            body: formData,
          });

          const data = await res.json();
          if (res.ok && data.success && data.url) {
            finalUrl = data.url;
            notify("Image téléversée avec succès !", "success");
          } else {
            notify(`Erreur d'upload: ${data.message || "Échec."}`, "error");
            return;
          }
        } catch (err: any) {
          notify(`Erreur réseau lors de l'upload: ${err.message}`, "error");
          return;
        }
      }

      if (finalUrl) {
        updateDraft(bindPath, finalUrl);
      }
      closePopover();
    });

    markdownClose?.addEventListener("click", closePopover);
    markdownCancel?.addEventListener("click", closePopover);
    markdownSave?.addEventListener("click", () => {
      if (!activeTargetElement) return;
      const bindPath = activeTargetElement.getAttribute("data-cms-bind");
      if (!bindPath) return;

      const htmlContent = tiptapContainer?.innerHTML.trim() || "";
      if (htmlContent) {
        updateDraft(bindPath, htmlContent);
      }
      closePopover();
    });

    popoverReset?.addEventListener("click", resetElement);
    modeEditBtn?.addEventListener("click", () => setEditingMode(true));
    modePreviewBtn?.addEventListener("click", () => setEditingMode(false));
    popoverClose?.addEventListener("click", closePopover);
    popoverCancel?.addEventListener("click", closePopover);
    popoverSave?.addEventListener("click", applyChange);


    popoverTextInput?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        applyChange();
      }
    });
    popoverHrefInput?.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        e.preventDefault();
        applyChange();
      }
    });
    popoverTextareaInput?.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        applyChange();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        if (popover && !popover.classList.contains("hidden")) {
          closePopover();
        } else if (createContentModal && !createContentModal.classList.contains("hidden")) {
          closeCreateContentModal();
        } else if (confirmDeleteModal && !confirmDeleteModal.classList.contains("hidden")) {
          closeConfirmDeleteModal();
        } else if (draftsModal && !draftsModal.classList.contains("hidden")) {
          closeDraftsModal();
        } else if (resetModal && !resetModal.classList.contains("hidden")) {
          closeResetModal();
        } else if (errorModal && !errorModal.classList.contains("hidden")) {
          closeErrorModal();
        }
      }
    });

    document.addEventListener("click", handleElementClick);

    checkAuthState();
    syncDraftsWithDOM();
  }

  initAdminToolbar();
  document.addEventListener("astro:after-swap", initAdminToolbar);
</script>
