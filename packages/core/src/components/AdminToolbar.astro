---
import { hashSha256 } from "../utils/auth.js";

interface Props {
  adminSecret?: string;
  siteId?: string;
  gitEnabled?: boolean;
  scrollable?: boolean;
}

const rawSecret =
  Astro.props.adminSecret ||
  import.meta.env.CMS_ADMIN_SECRET ||
  process.env.CMS_ADMIN_SECRET ||
  "admin123";
const siteId = Astro.props.siteId || "default";
const hashedSecret = await hashSha256(rawSecret);
const scrollable = Astro.props.scrollable ?? true;

const envGitEnabled =
  import.meta.env.CMS_GIT_ENABLED ?? process.env.CMS_GIT_ENABLED;

const gitEnabled =
  Astro.props.gitEnabled !== undefined
    ? Astro.props.gitEnabled
    : String(envGitEnabled).toLowerCase() === "true" ||
      String(envGitEnabled) === "1";
---

<div
  id="ml-admin-toolbar-root"
  data-site-id={siteId}
  data-secret={hashedSecret}
  data-git-enabled={gitEnabled ? "true" : "false"}
>
  <div
    id="ml-admin-bar"
    class={`ml-admin-bar hidden ${scrollable ? "ml-admin-bar-scrollable" : ""}`}
  >
    <div class="ml-admin-bar-container">
      <div class="ml-admin-left">
        <span class="ml-admin-badge ml-badge-admin">
          <span class="ml-status-dot ml-dot-green"></span>
          Admin
        </span>

        <div
          class="ml-segmented-control ml-segmented-control-dark"
          role="radiogroup"
          aria-label="Mode de travail"
        >
          <button
            type="button"
            id="ml-admin-mode-preview"
            class="ml-segment-btn active"
            role="radio"
            aria-checked="true"
            title="Mode Aperçu"
          >
            <i class="ml-icon-eye-line ml-icon--xs"></i>
            <span>Aperçu</span>
          </button>

          <button
            type="button"
            id="ml-admin-mode-edit"
            class="ml-segment-btn"
            role="radio"
            aria-checked="false"
            title="Mode Édition"
          >
            <i class="ml-icon-edit-line ml-icon--xs"></i>
            <span>Édition</span>
          </button>
        </div>
      </div>

      <div
        class="ml-admin-right"
        style="display: flex; align-items: center; gap: 0.75rem;"
      >
        <div
          id="ml-admin-notification-zone"
          class="ml-admin-notification-zone ml-notification--info hidden"
          aria-live="polite"
        >
          <span
            id="ml-admin-notification-icon"
            class="ml-icon ml-icon--xs ml-icon-information-line"></span>
          <button
            type="button"
            id="ml-admin-notification-text"
            class="ml-admin-notification-btn"
            title="Voir les détails"></button>
          <button
            type="button"
            id="ml-admin-notification-details-btn"
            class="ml-admin-notification-action-btn hidden"
            title="Voir le détail des erreurs">Détails</button
          >
          <button
            type="button"
            id="ml-admin-notification-dismiss"
            class="ml-admin-notification-close-btn hidden"
            aria-label="Masquer la notification">&times;</button
          >
        </div>

        <button
          type="button"
          id="ml-admin-save-btn"
          class="ml-btn ml-btn--primary ml-btn--sm"
          title="Enregistrer les modifications"
          disabled
        >
          <i class="ml-icon-save-line ml-icon--xs"></i>
          <span>Enregistrer</span>
        </button>

        <button
          type="button"
          id="ml-admin-reset-btn"
          class="ml-btn ml-btn--secondary ml-btn--sm hidden"
          title="Réinitialiser toutes les données locales pour afficher l'état exact du serveur"
        >
          <i class="ml-icon-refresh-line ml-icon--xs"></i>
          <span>Réinitialiser</span>
        </button>

        <button
          type="button"
          id="ml-admin-publish-btn"
          class="ml-btn ml-btn--success ml-btn--sm hidden"
          title="Publier les modifications sur GitHub"
          disabled
        >
          <i class="ml-icon-upload-cloud-line ml-icon--xs"></i>
          <span>Publier</span>
        </button>
      </div>
    </div>
  </div>

  <div
    id="ml-cms-edit-popover"
    class="ml-cms-popover hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ml-cms-popover-title"
  >
    <div class="ml-cms-popover-header">
      <span class="ml-cms-popover-badge" id="ml-cms-popover-bind-key"
        >field</span
      >
      <h3 id="ml-cms-popover-title" class="ml-cms-popover-heading">
        Éditer l'élément
      </h3>
      <button
        type="button"
        id="ml-cms-popover-close"
        class="ml-cms-popover-close-btn"
        aria-label="Fermer">&times;</button
      >
    </div>
    <div class="ml-cms-popover-body">
      <div class="ml-form-group">
        <label for="ml-cms-popover-input" class="ml-form-label"
          >Contenu textuel</label
        >
        <textarea
          id="ml-cms-popover-input"
          class="ml-form-input ml-cms-textarea"
          rows="3"></textarea>
      </div>
    </div>
    <div class="ml-cms-popover-footer">
      <button
        type="button"
        id="ml-cms-popover-reset"
        class="ml-btn ml-btn--danger ml-btn--sm hidden"
        title="Rétablir la valeur initiale">Rétablir initial</button
      >
      <button
        type="button"
        id="ml-cms-popover-cancel"
        class="ml-btn ml-btn--secondary ml-btn--sm">Annuler</button
      >
      <button
        type="button"
        id="ml-cms-popover-save"
        class="ml-btn ml-btn--primary ml-btn--sm">Appliquer</button
      >
    </div>
  </div>

  <div
    id="ml-cms-drafts-modal"
    class="ml-cms-modal-overlay hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ml-cms-modal-title"
  >
    <div class="ml-cms-modal-content">
      <div class="ml-cms-modal-header">
        <h3 id="ml-cms-modal-title" class="ml-cms-modal-heading">
          Modifications non enregistrées
        </h3>
        <button
          type="button"
          id="ml-cms-modal-close"
          class="ml-cms-popover-close-btn"
          aria-label="Fermer">&times;</button
        >
      </div>
      <div class="ml-cms-modal-body">
        <p class="ml-cms-modal-desc">
          Voici la liste des modifications locales non encore enregistrées :
        </p>
        <div id="ml-cms-modal-list" class="ml-cms-drafts-list"></div>
      </div>
      <div class="ml-cms-modal-footer">
        <button
          type="button"
          id="ml-cms-modal-clear-all"
          class="ml-btn ml-btn--danger ml-btn--sm">Tout réinitialiser</button
        >
        <button
          type="button"
          id="ml-cms-modal-done"
          class="ml-btn ml-btn--secondary ml-btn--sm">Fermer</button
        >
      </div>
    </div>
  </div>

  <div
    id="ml-cms-reset-modal"
    class="ml-cms-modal-overlay hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ml-cms-reset-title"
  >
    <div class="ml-cms-modal-content">
      <div class="ml-cms-modal-header">
        <h3 id="ml-cms-reset-title" class="ml-cms-modal-heading">
          Réinitialiser le contenu local
        </h3>
        <button
          type="button"
          id="ml-cms-reset-close"
          class="ml-cms-popover-close-btn"
          aria-label="Fermer">&times;</button
        >
      </div>
      <div class="ml-cms-modal-body">
        <p class="ml-cms-modal-desc">
          Voulez-vous retirer les modifications locales qui n'ont pas encore été
          publiées, comme les brouillons et les enregistrements conservés dans
          votre navigateur, pour réafficher l'état exact du serveur ?
        </p>
      </div>
      <div class="ml-cms-modal-footer">
        <button
          type="button"
          id="ml-cms-reset-cancel"
          class="ml-btn ml-btn--secondary ml-btn--sm">Annuler</button
        >
        <button
          type="button"
          id="ml-cms-reset-confirm"
          class="ml-btn ml-btn--danger ml-btn--sm">Réinitialiser</button
        >
      </div>
    </div>
  </div>

  <div
    id="ml-cms-error-modal"
    class="ml-cms-modal-overlay hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ml-cms-error-title"
  >
    <div class="ml-cms-modal-content">
      <div class="ml-cms-modal-header ml-cms-modal-header-error">
        <h3 id="ml-cms-error-title" class="ml-cms-modal-heading ml-text-danger">
          Échec de la publication
        </h3>
        <button
          type="button"
          id="ml-cms-error-close"
          class="ml-cms-popover-close-btn"
          aria-label="Fermer">&times;</button
        >
      </div>
      <div class="ml-cms-modal-body">
        <div class="ml-cms-error-alert-box">
          <i class="ml-icon-alert-fill ml-icon--sm"></i>
          <p id="ml-cms-error-message" class="ml-cms-error-msg"></p>
        </div>
        <div
          id="ml-cms-error-details-list"
          class="ml-cms-error-details-list hidden"
        >
        </div>
      </div>
      <div class="ml-cms-modal-footer">
        <button
          type="button"
          id="ml-cms-error-done"
          class="ml-btn ml-btn--secondary ml-btn--sm">Fermer</button
        >
      </div>
    </div>
  </div>
</div>

<style>
  .ml-admin-bar {
    position: sticky;
    top: 0;
    z-index: 9999;
    background: #0f172a;
    color: #f8fafc;
    font-family: inherit;
    font-size: 0.875rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
    border-bottom: 2px solid #0284c7;
  }
  .ml-admin-bar-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.375rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  /* Optional Horizontal Scroll for Admin Toolbar (Mobile/Responsive) */
  .ml-admin-bar-scrollable .ml-admin-bar-container,
  .ml-admin-bar-container.ml-admin-bar-scrollable {
    overflow-x: auto;
    overflow-y: hidden;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .ml-admin-bar-scrollable .ml-admin-bar-container::-webkit-scrollbar,
  .ml-admin-bar-container.ml-admin-bar-scrollable::-webkit-scrollbar {
    display: none;
  }
  .ml-admin-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .ml-admin-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .ml-badge-admin {
    background: rgba(14, 165, 233, 0.15);
    color: #38bdf8;
  }
  .ml-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  @keyframes ml-pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    70% {
      transform: scale(1.1);
      box-shadow: 0 0 0 6px rgba(34, 197, 94, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }
  .ml-dot-green {
    background-color: #22c55e;
    animation: ml-pulse 2s infinite;
  }
  @keyframes ml-spin {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }
  .ml-spin {
    animation: ml-spin 1s linear infinite;
  }
  .ml-admin-notification-zone {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }
  .ml-notification--info {
    background: rgba(56, 189, 248, 0.12);
    color: #38bdf8;
    border: 1px solid rgba(56, 189, 248, 0.25);
  }
  .ml-notification--success {
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
    border: 1px solid rgba(34, 197, 94, 0.3);
  }
  .ml-notification--error {
    background: rgba(244, 63, 94, 0.18);
    color: #fb7185;
    border: 1px solid rgba(244, 63, 94, 0.35);
  }
  .ml-admin-notification-btn {
    background: transparent;
    border: none;
    color: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: underline;
    padding: 0;
    font-family: inherit;
  }
  .ml-admin-notification-btn:hover {
    opacity: 0.85;
  }
  .ml-admin-notification-action-btn {
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid currentColor;
    color: inherit;
    font-size: 0.7rem;
    font-weight: 600;
    border-radius: 4px;
    padding: 0.1rem 0.4rem;
    cursor: pointer;
    font-family: inherit;
  }
  .ml-admin-notification-action-btn:hover {
    background: rgba(255, 255, 255, 0.25);
  }
  .ml-admin-notification-close-btn {
    background: transparent;
    border: none;
    color: inherit;
    font-size: 1rem;
    cursor: pointer;
    line-height: 1;
    padding: 0 0.2rem;
    opacity: 0.75;
  }
  .ml-admin-notification-close-btn:hover {
    opacity: 1;
  }
  .ml-cms-modal-header-error {
    background: #fff1f2;
    border-bottom: 1px solid #fecdd3;
  }
  .ml-text-danger {
    color: #e11d48 !important;
  }
  .ml-cms-error-alert-box {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    background: #fff1f2;
    border: 1px solid #fecdd3;
    color: #9f1239;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    margin-bottom: 0.75rem;
  }
  .ml-cms-error-msg {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    word-break: break-word;
  }
  .ml-cms-error-details-list {
    font-family: monospace;
    font-size: 0.75rem;
    background: #0f172a;
    color: #f8fafc;
    padding: 0.75rem;
    border-radius: 6px;
    max-height: 200px;
    overflow-y: auto;
    white-space: pre-wrap;
  }

  /* Inline CMS Popover styles */
  .ml-cms-popover {
    position: fixed;
    z-index: 10000;
    width: 360px;
    max-width: calc(100vw - 2rem);
    background: #ffffff;
    color: #0f172a;
    border-radius: 12px;
    box-shadow:
      0 10px 25px -5px rgba(0, 0, 0, 0.2),
      0 8px 10px -6px rgba(0, 0, 0, 0.1);
    border: 1px solid #e2e8f0;
    padding: 1rem;
    font-family:
      system-ui,
      -apple-system,
      sans-serif;
  }
  .ml-cms-popover-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .ml-cms-popover-badge {
    font-size: 0.7rem;
    font-family: monospace;
    background: #e0f2fe;
    color: #0369a1;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-weight: 600;
  }
  .ml-cms-popover-heading {
    font-size: 0.9rem;
    font-weight: 700;
    margin: 0;
    color: #0f172a;
    flex-grow: 1;
  }
  .ml-cms-popover-close-btn {
    background: transparent;
    border: none;
    font-size: 1.25rem;
    cursor: pointer;
    color: #64748b;
    line-height: 1;
    padding: 0.2rem 0.4rem;
  }
  .ml-cms-popover-close-btn:hover {
    color: #0f172a;
  }
  .ml-cms-popover-body {
    margin-bottom: 1rem;
  }
  .ml-form-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .ml-form-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: #475569;
  }
  .ml-cms-textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.5rem;
    font-size: 0.875rem;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    resize: vertical;
    outline-color: #0284c7;
  }
  .ml-cms-popover-footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
  }
  .ml-btn {
    padding: 0.35rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 6px;
    cursor: pointer;
    border: 1px solid transparent;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    transition: all 0.15s ease;
  }
  .ml-btn--secondary {
    background: #f1f5f9;
    color: #475569;
    border-color: #cbd5e1;
  }
  .ml-btn--secondary:hover {
    background: #e2e8f0;
  }
  .ml-btn--primary {
    background: #0284c7;
    color: #ffffff;
  }
  .ml-btn--primary:hover {
    background: #0369a1;
  }
  .ml-btn--danger {
    background: #fff1f2;
    color: #e11d48;
    border-color: #fecdd3;
  }
  .ml-btn--danger:hover {
    background: #ffe4e6;
  }
  .ml-btn--success {
    background: #16a34a;
    color: #ffffff;
  }
  .ml-btn--success:hover {
    background: #15803d;
  }

  .ml-btn:disabled,
  .ml-btn[disabled] {
    opacity: 0.4;
    cursor: not-allowed;
    pointer-events: none;
  }

  /* Drafts Modal */
  .ml-cms-modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 10005;
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
  }
  .ml-cms-modal-content {
    background: #ffffff;
    color: #0f172a;
    border-radius: 12px;
    width: 520px;
    max-width: 100%;
    max-height: 80vh;
    display: flex;
    flex-direction: column;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);
    border: 1px solid #e2e8f0;
  }
  .ml-cms-modal-header {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .ml-cms-modal-heading {
    font-size: 1rem;
    font-weight: 700;
    margin: 0;
    color: #0f172a;
  }
  .ml-cms-modal-body {
    padding: 1.25rem;
    overflow-y: auto;
    flex-grow: 1;
  }
  .ml-cms-modal-desc {
    margin-top: 0;
    margin-bottom: 1rem;
    font-size: 0.85rem;
    color: #64748b;
  }
  .ml-cms-drafts-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .ml-cms-draft-item {
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .ml-cms-draft-key {
    font-size: 0.75rem;
    font-family: monospace;
    color: #0369a1;
    font-weight: 600;
  }
  .ml-cms-draft-val {
    font-size: 0.85rem;
    color: #1e293b;
    background: #ffffff;
    padding: 0.35rem 0.5rem;
    border-radius: 4px;
    border: 1px solid #cbd5e1;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .ml-cms-draft-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.25rem;
  }
  .ml-cms-modal-footer {
    padding: 0.75rem 1.25rem;
    border-top: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #f8fafc;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
  }

  .hidden {
    display: none !important;
  }

  @media (max-width: 767px) {
    .ml-admin-bar {
      position: fixed;
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      border-bottom: none;
      border-top: 2px solid #0284c7;
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.4);
      background: rgba(15, 23, 42, 0.96);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding-bottom: env(safe-area-inset-bottom, 0px);
    }
    .ml-admin-bar-container {
      padding: 0.4rem 0.5rem;
      gap: 0.35rem;
      max-width: 100%;
      width: 100%;
      box-sizing: border-box;
    }
    .ml-admin-left {
      gap: 0.35rem;
      flex-shrink: 0;
    }
    .ml-badge-admin {
      padding: 0.25rem 0.35rem;
    }
    .ml-badge-admin span:not(.ml-status-dot) {
      display: none;
    }
    .ml-segmented-control {
      padding: 2px;
      gap: 2px;
    }
    .ml-segment-btn {
      padding: 0.3rem 0.45rem;
      font-size: 0.75rem;
      gap: 0.25rem;
    }
    .ml-admin-right {
      gap: 0.35rem !important;
      flex-shrink: 0;
    }
    .ml-btn {
      padding: 0.35rem 0.55rem;
      font-size: 0.75rem;
      gap: 0.25rem;
      white-space: nowrap;
    }
    .ml-btn span {
      display: inline-block;
    }

    .ml-admin-notification-zone {
      position: absolute;
      bottom: calc(100% + 10px);
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 20px);
      max-width: 480px;
      background: rgba(15, 23, 42, 0.96);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding: 0.5rem 0.75rem;
      border-radius: 10px;
      box-shadow:
        0 10px 25px -5px rgba(0, 0, 0, 0.4),
        0 4px 6px -2px rgba(0, 0, 0, 0.2);
      z-index: 10000;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      box-sizing: border-box;
      animation: ml-slide-up 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .ml-admin-notification-btn {
      white-space: normal;
      word-break: break-word;
      text-align: left;
      flex: 1;
      min-width: 0;
    }
  }

  @keyframes ml-slide-up {
    from {
      opacity: 0;
      transform: translate(-50%, 8px);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  @media (max-width: 380px) {
    .ml-admin-bar-container {
      padding: 0.35rem 0.25rem;
      gap: 0.25rem;
    }
    .ml-segment-btn {
      padding: 0.25rem 0.35rem;
      font-size: 0.7rem;
    }
    .ml-btn {
      padding: 0.3rem 0.45rem;
      font-size: 0.7rem;
    }
  }

  :global(:root[data-cms-editing="true"]) {
    scroll-padding-top: 0;
  }
  @media (max-width: 767px) {
    :global(body.ml-admin-logged-in) {
      padding-bottom: calc(58px + env(safe-area-inset-bottom, 0px)) !important;
    }
  }
</style>

<script>
  import { getAdminCookieToken } from "../utils/auth.js";
  import {
    cmsDraftStore,
    cmsSavedStore,
    updateDraft,
    removeDraft,
    clearDrafts,
    addSavedChanges,
    removeSaved,
    clearSavedChanges,
    resetAllCmsState,
  } from "../store/cms.js";

  const STORAGE_KEY_UNPUBLISHED = "cms_has_unpublished_changes";

  function initAdminToolbar() {
    const root = document.getElementById("ml-admin-toolbar-root");
    if (!root) return;

    const bar = document.getElementById("ml-admin-bar");
    const modeEditBtn = document.getElementById("ml-admin-mode-edit");
    const modePreviewBtn = document.getElementById("ml-admin-mode-preview");
    const saveBtn = document.getElementById("ml-admin-save-btn");
    const publishBtn = document.getElementById("ml-admin-publish-btn");
    const resetBtn = document.getElementById("ml-admin-reset-btn");

    const notificationZone = document.getElementById(
      "ml-admin-notification-zone",
    );
    const notificationIcon = document.getElementById(
      "ml-admin-notification-icon",
    );
    const notificationText = document.getElementById(
      "ml-admin-notification-text",
    ) as HTMLButtonElement | null;
    const notificationDetailsBtn = document.getElementById(
      "ml-admin-notification-details-btn",
    ) as HTMLButtonElement | null;
    const notificationDismissBtn = document.getElementById(
      "ml-admin-notification-dismiss",
    ) as HTMLButtonElement | null;

    const popover = document.getElementById("ml-cms-edit-popover");
    const popoverBindKey = document.getElementById("ml-cms-popover-bind-key");
    const popoverInput = document.getElementById(
      "ml-cms-popover-input",
    ) as HTMLTextAreaElement | null;
    const popoverClose = document.getElementById("ml-cms-popover-close");
    const popoverCancel = document.getElementById("ml-cms-popover-cancel");
    const popoverReset = document.getElementById("ml-cms-popover-reset");
    const popoverSave = document.getElementById("ml-cms-popover-save");

    const draftsModal = document.getElementById("ml-cms-drafts-modal");
    const draftsModalList = document.getElementById("ml-cms-modal-list");
    const draftsModalClose = document.getElementById("ml-cms-modal-close");
    const draftsModalDone = document.getElementById("ml-cms-modal-done");
    const draftsModalClearAll = document.getElementById(
      "ml-cms-modal-clear-all",
    );

    const resetModal = document.getElementById("ml-cms-reset-modal");
    const resetModalClose = document.getElementById("ml-cms-reset-close");
    const resetModalCancel = document.getElementById("ml-cms-reset-cancel");
    const resetModalConfirm = document.getElementById("ml-cms-reset-confirm");

    const errorModal = document.getElementById("ml-cms-error-modal");
    const errorModalTitle = document.getElementById("ml-cms-error-title");
    const errorModalMsg = document.getElementById("ml-cms-error-message");
    const errorModalDetails = document.getElementById(
      "ml-cms-error-details-list",
    );
    const errorModalClose = document.getElementById("ml-cms-error-close");
    const errorModalDone = document.getElementById("ml-cms-error-done");

    const expectedHash = root.getAttribute("data-secret") || "";
    const isGitEnabled = root.getAttribute("data-git-enabled") === "true";
    let activeTargetElement: HTMLElement | null = null;
    let lastErrorData: {
      title: string;
      message: string;
      details?: string[];
    } | null = null;

    function notify(
      message: string,
      type: "info" | "success" | "error" = "info",
      details?: string[],
    ) {
      if (!notificationZone || !notificationText) return;

      notificationZone.className = `ml-admin-notification-zone ml-notification--${type}`;
      notificationText.textContent = message;

      if (notificationIcon) {
        notificationIcon.className = `ml-icon ml-icon--xs ${
          type === "error"
            ? "ml-icon-alert-fill"
            : type === "success"
              ? "ml-icon-checkbox-circle-fill"
              : "ml-icon-information-line"
        }`;
      }

      if (type === "error") {
        lastErrorData = { title: "Échec de l'opération", message, details };
        if (notificationDetailsBtn)
          notificationDetailsBtn.classList.remove("hidden");
        if (notificationDismissBtn)
          notificationDismissBtn.classList.remove("hidden");
      } else if (type === "success") {
        lastErrorData = null;
        if (notificationDetailsBtn)
          notificationDetailsBtn.classList.remove("hidden");
        if (notificationDismissBtn)
          notificationDismissBtn.classList.remove("hidden");
      } else {
        lastErrorData = null;
        if (notificationDetailsBtn)
          notificationDetailsBtn.classList.add("hidden");
        if (notificationDismissBtn)
          notificationDismissBtn.classList.add("hidden");
      }

      notificationZone.classList.remove("hidden");
    }

    function setSaveLoading(loading: boolean) {
      if (!saveBtn) return;
      (saveBtn as HTMLButtonElement).disabled = loading;
      if (loading) {
        saveBtn.innerHTML = `<i class="ml-icon-refresh-line ml-spin ml-icon--xs"></i><span>Enregistrement...</span>`;
      } else {
        saveBtn.innerHTML = `<i class="ml-icon-save-line ml-icon--xs"></i><span>Enregistrer</span>`;
      }
    }

    function setPublishLoading(loading: boolean) {
      if (!publishBtn) return;
      (publishBtn as HTMLButtonElement).disabled = loading;
      if (loading) {
        publishBtn.innerHTML = `<i class="ml-icon-refresh-line ml-spin ml-icon--xs"></i><span>Publication...</span>`;
      } else {
        publishBtn.innerHTML = `<i class="ml-icon-upload-cloud-line ml-icon--xs"></i><span>Publier</span>`;
      }
    }

    function openErrorModal() {
      if (!errorModal || !lastErrorData) return;
      if (errorModalTitle) errorModalTitle.textContent = lastErrorData.title;
      if (errorModalMsg) errorModalMsg.textContent = lastErrorData.message;

      if (errorModalDetails) {
        if (lastErrorData.details && lastErrorData.details.length > 0) {
          errorModalDetails.textContent = lastErrorData.details.join("\n");
          errorModalDetails.classList.remove("hidden");
        } else {
          errorModalDetails.classList.add("hidden");
        }
      }

      errorModal.classList.remove("hidden");
    }

    function closeErrorModal() {
      errorModal?.classList.add("hidden");
    }

    function openResetModal() {
      resetModal?.classList.remove("hidden");
    }

    function closeResetModal() {
      resetModal?.classList.add("hidden");
    }

    function updateToolbarButtonsState() {
      const drafts = cmsDraftStore.get();
      const hasDrafts = Object.keys(drafts).length > 0;
      const hasUnpublished =
        localStorage.getItem(STORAGE_KEY_UNPUBLISHED) === "true";

      if (saveBtn) {
        (saveBtn as HTMLButtonElement).disabled = !hasDrafts;
      }

      if (publishBtn) {
        (publishBtn as HTMLButtonElement).disabled =
          !isGitEnabled || hasDrafts || !hasUnpublished;
      }

      if (hasDrafts) {
        const count = Object.keys(drafts).length;
        const s = count > 1 ? "s" : "";
        notify(`${count} modification${s} non enregistrée${s}`, "info");
      } else if (hasUnpublished && isGitEnabled) {
        notify("Modifications enregistrées. Prêt pour publication.", "info");
      } else if (!lastErrorData) {
        notificationZone?.classList.add("hidden");
      }
    }

    function renderDraftsModal() {
      if (!draftsModalList) return;
      const drafts = cmsDraftStore.get();
      const keys = Object.keys(drafts);

      if (keys.length === 0) {
        draftsModalList.innerHTML = `<p style="font-size:0.85rem; color:#64748b; margin:0;">Aucune modification en cours.</p>`;
        return;
      }

      draftsModalList.innerHTML = "";
      keys.forEach((key) => {
        const item = document.createElement("div");
        item.className = "ml-cms-draft-item";

        const keySpan = document.createElement("div");
        keySpan.className = "ml-cms-draft-key";
        keySpan.textContent = key;

        const valDiv = document.createElement("div");
        valDiv.className = "ml-cms-draft-val";
        valDiv.textContent = drafts[key];

        const actionsDiv = document.createElement("div");
        actionsDiv.className = "ml-cms-draft-actions";

        const removeBtn = document.createElement("button");
        removeBtn.type = "button";
        removeBtn.className = "ml-btn ml-btn--danger ml-btn--sm";
        removeBtn.textContent = "Rétablir initial";
        removeBtn.addEventListener("click", () => {
          removeDraft(key);
          renderDraftsModal();
        });

        actionsDiv.appendChild(removeBtn);
        item.appendChild(keySpan);
        item.appendChild(valDiv);
        item.appendChild(actionsDiv);
        draftsModalList.appendChild(item);
      });
    }

    function openDraftsModal() {
      renderDraftsModal();
      draftsModal?.classList.remove("hidden");
    }

    function closeDraftsModal() {
      draftsModal?.classList.add("hidden");
    }

    function cacheOriginalValues() {
      const elements = document.querySelectorAll("[data-cms-bind]");
      elements.forEach((el) => {
        if (!el.hasAttribute("data-cms-original")) {
          el.setAttribute("data-cms-original", el.textContent?.trim() || "");
        }
      });
    }

    function syncDraftsWithDOM() {
      cacheOriginalValues();
      const drafts = cmsDraftStore.get();
      const saved = cmsSavedStore.get();
      const elements = document.querySelectorAll("[data-cms-bind]");

      elements.forEach((el) => {
        const path = el.getAttribute("data-cms-bind");
        const original = el.getAttribute("data-cms-original") || "";

        if (path && drafts[path] !== undefined) {
          el.textContent = drafts[path];
          el.setAttribute("data-cms-has-draft", "true");
          el.removeAttribute("data-cms-has-saved");
        } else if (path && saved[path] !== undefined) {
          el.textContent = saved[path];
          el.removeAttribute("data-cms-has-draft");
          el.setAttribute("data-cms-has-saved", "true");
        } else {
          el.textContent = original;
          el.removeAttribute("data-cms-has-draft");
          el.removeAttribute("data-cms-has-saved");
        }
      });

      updateToolbarButtonsState();
    }

    function setEditingMode(active: boolean) {
      document.body.classList.toggle("cms-mode-editing", active);
      document.documentElement.setAttribute("data-cms-editing", String(active));

      if (active) {
        modeEditBtn?.classList.add("active");
        modeEditBtn?.setAttribute("aria-checked", "true");
        modePreviewBtn?.classList.remove("active");
        modePreviewBtn?.setAttribute("aria-checked", "false");
      } else {
        modeEditBtn?.classList.remove("active");
        modeEditBtn?.setAttribute("aria-checked", "false");
        modePreviewBtn?.classList.add("active");
        modePreviewBtn?.setAttribute("aria-checked", "true");
        closePopover();
      }

      document.dispatchEvent(
        new CustomEvent("cms:editing-toggled", {
          detail: { isEditing: active },
        }),
      );
    }

    function checkAuthState() {
      const token = getAdminCookieToken();
      const isAuthenticated =
        token !== null &&
        token.length > 0 &&
        (!expectedHash || token === expectedHash);

      if (isAuthenticated) {
        bar?.classList.remove("hidden");
        document.body.classList.add("ml-admin-logged-in");
        saveBtn?.classList.remove("hidden");
        resetBtn?.classList.remove("hidden");
        if (isGitEnabled) {
          publishBtn?.classList.remove("hidden");
        } else {
          publishBtn?.classList.add("hidden");
        }
        setEditingMode(false);
      } else {
        bar?.classList.add("hidden");
        document.body.classList.remove("ml-admin-logged-in");
        saveBtn?.classList.add("hidden");
        publishBtn?.classList.add("hidden");
        resetBtn?.classList.add("hidden");
        setEditingMode(false);
        resetAllCmsState();
        localStorage.removeItem(STORAGE_KEY_UNPUBLISHED);
      }
    }

    async function closePopover() {
      if (activeTargetElement) {
        activeTargetElement.removeAttribute("data-cms-active");
        const bindKey = activeTargetElement.getAttribute("data-cms-bind");
        if (bindKey) {
          const token = getAdminCookieToken();
          try {
            await fetch("/api/cms/lock", {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                ...(token ? { Authorization: `Bearer ${token}` } : {}),
              },
              body: JSON.stringify({ resourceId: bindKey, action: "release" }),
            });
          } catch {}
        }
      }
      popover?.classList.add("hidden");
      activeTargetElement = null;
    }

    async function openPopover(el: HTMLElement, event: MouseEvent) {
      if (activeTargetElement) {
        activeTargetElement.removeAttribute("data-cms-active");
      }
      const bindKey = el.getAttribute("data-cms-bind") || "element";
      const token = getAdminCookieToken();

      try {
        const lockRes = await fetch("/api/cms/lock", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            ...(token ? { Authorization: `Bearer ${token}` } : {}),
          },
          body: JSON.stringify({ resourceId: bindKey, action: "acquire" }),
        });

        if (lockRes.status === 423) {
          const lockData = await lockRes.json();
          notify(
            `⚠️ Élément actuellement en cours d'édition par ${lockData.holderName || "un autre administrateur"}.`,
            "info",
          );
          return;
        }
      } catch (err: any) {
        console.warn("Échec de la vérification de verrou:", err);
      }

      activeTargetElement = el;
      activeTargetElement.setAttribute("data-cms-active", "true");
      const drafts = cmsDraftStore.get();
      const saved = cmsSavedStore.get();
      const hasDraft = bindKey in drafts;
      const hasSaved = bindKey in saved;

      if (popoverBindKey) popoverBindKey.textContent = bindKey;
      if (popoverInput) popoverInput.value = el.textContent?.trim() || "";

      if (hasDraft || hasSaved) {
        popoverReset?.classList.remove("hidden");
      } else {
        popoverReset?.classList.add("hidden");
      }

      if (popover) {
        popover.classList.remove("hidden");
        const rect = el.getBoundingClientRect();
        const popoverWidth = 360;
        let left = rect.left + window.scrollX;
        let top = rect.bottom + window.scrollY + 8;

        if (left + popoverWidth > window.innerWidth - 16) {
          left = Math.max(16, window.innerWidth - popoverWidth - 16);
        }

        popover.style.left = `${left}px`;
        popover.style.top = `${top}px`;
        popoverInput?.focus();
      }
    }

    async function handleElementClick(event: MouseEvent) {
      if (document.documentElement.getAttribute("data-cms-editing") !== "true")
        return;
      const target = (event.target as HTMLElement).closest(
        "[data-cms-bind]",
      ) as HTMLElement | null;
      if (!target) return;

      if (
        target.children.length > 0 &&
        Array.from(target.children).some(
          (child) => !child.classList.contains("ml-tricolor-bar"),
        )
      ) {
        return;
      }

      event.preventDefault();
      event.stopPropagation();
      await openPopover(target, event);
    }

    function resetElement() {
      if (!activeTargetElement) return;
      const bindPath = activeTargetElement.getAttribute("data-cms-bind");
      if (bindPath) {
        removeDraft(bindPath);
        removeSaved(bindPath);
      }
      closePopover();
    }

    function applyChange() {
      if (!activeTargetElement || !popoverInput) return;
      const newValue = popoverInput.value.trim();
      const bindPath = activeTargetElement.getAttribute("data-cms-bind");
      const originalValue =
        activeTargetElement.getAttribute("data-cms-original") || "";

      if (bindPath) {
        if (newValue === originalValue) {
          removeDraft(bindPath);
          removeSaved(bindPath);
        } else {
          updateDraft(bindPath, newValue);
        }
      }

      closePopover();
    }

    cmsDraftStore.subscribe(() => {
      syncDraftsWithDOM();
    });

    cmsSavedStore.subscribe(() => {
      syncDraftsWithDOM();
    });

    saveBtn?.addEventListener("click", async () => {
      const drafts = cmsDraftStore.get();
      if (Object.keys(drafts).length === 0) return;

      const token = getAdminCookieToken();
      setSaveLoading(true);
      notify("Enregistrement en cours...", "info");

      try {
        const response = await fetch("/api/cms/save", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            ...(token ? { Authorization: `Bearer ${token}` } : {}),
          },
          body: JSON.stringify({ drafts }),
        });

        const resData = await response.json();
        setSaveLoading(false);

        if (response.ok && resData.success) {
          addSavedChanges(drafts);
          clearDrafts();
          localStorage.setItem(STORAGE_KEY_UNPUBLISHED, "true");
          updateToolbarButtonsState();
          notify("Modifications enregistrées avec succès !", "success");
          setTimeout(() => {
            if (localStorage.getItem(STORAGE_KEY_UNPUBLISHED) === "true") {
              notify(
                "Modifications enregistrées. Prêt pour publication.",
                "info",
              );
            }
          }, 3000);
        } else {
          notify(
            `Erreur: ${resData.message || "Échec de la sauvegarde."}`,
            "error",
            resData.errors,
          );
          updateToolbarButtonsState();
        }
      } catch (err: any) {
        setSaveLoading(false);
        notify(
          `Erreur réseau: ${err.message || "Impossible de contacter le serveur."}`,
          "error",
          [err.message],
        );
        updateToolbarButtonsState();
      }

      document.dispatchEvent(
        new CustomEvent("cms:save-requested", { detail: { drafts } }),
      );
    });

    publishBtn?.addEventListener("click", async () => {
      const drafts = cmsDraftStore.get();
      if (
        Object.keys(drafts).length > 0 ||
        localStorage.getItem(STORAGE_KEY_UNPUBLISHED) !== "true"
      )
        return;

      const token = getAdminCookieToken();
      setPublishLoading(true);
      notify("Publication sur GitHub en cours...", "info");

      try {
        const response = await fetch("/api/cms/publish", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            ...(token ? { Authorization: `Bearer ${token}` } : {}),
          },
        });

        const resData = await response.json();
        setPublishLoading(false);

        if (response.ok && resData.success) {
          clearSavedChanges();
          localStorage.removeItem(STORAGE_KEY_UNPUBLISHED);
          updateToolbarButtonsState();
          notify(
            resData.message ||
              "Modifications publiées sur GitHub avec succès !",
            "success",
          );
          setTimeout(() => {
            notificationZone?.classList.add("hidden");
          }, 4000);
        } else {
          notify(
            resData.message || "Échec de la publication sur GitHub.",
            "error",
            resData.errors,
          );
          updateToolbarButtonsState();
        }
      } catch (err: any) {
        setPublishLoading(false);
        notify(
          `Erreur réseau: ${err.message || "Impossible de contacter le serveur."}`,
          "error",
          [err.message],
        );
        updateToolbarButtonsState();
      }
    });

    resetBtn?.addEventListener("click", openResetModal);
    resetModalClose?.addEventListener("click", closeResetModal);
    resetModalCancel?.addEventListener("click", closeResetModal);
    resetModalConfirm?.addEventListener("click", () => {
      resetAllCmsState();
      localStorage.removeItem(STORAGE_KEY_UNPUBLISHED);
      syncDraftsWithDOM();
      closeResetModal();
      notify("Version du serveur rechargée avec succès.", "info");
      setTimeout(() => {
        notificationZone?.classList.add("hidden");
      }, 3000);
    });

    notificationText?.addEventListener("click", () => {
      if (lastErrorData) {
        openErrorModal();
        return;
      }
      const drafts = cmsDraftStore.get();
      if (Object.keys(drafts).length > 0) {
        openDraftsModal();
      }
    });

    notificationDetailsBtn?.addEventListener("click", openErrorModal);
    notificationDismissBtn?.addEventListener("click", () => {
      notificationZone?.classList.add("hidden");
    });

    errorModalClose?.addEventListener("click", closeErrorModal);
    errorModalDone?.addEventListener("click", closeErrorModal);

    draftsModalClose?.addEventListener("click", closeDraftsModal);
    draftsModalDone?.addEventListener("click", closeDraftsModal);
    draftsModalClearAll?.addEventListener("click", () => {
      openResetModal();
      closeDraftsModal();
    });

    popoverReset?.addEventListener("click", resetElement);
    modeEditBtn?.addEventListener("click", () => setEditingMode(true));
    modePreviewBtn?.addEventListener("click", () => setEditingMode(false));
    popoverClose?.addEventListener("click", closePopover);
    popoverCancel?.addEventListener("click", closePopover);
    popoverSave?.addEventListener("click", applyChange);

    document.addEventListener("click", handleElementClick);

    if (localStorage.getItem(STORAGE_KEY_UNPUBLISHED) !== "true") {
      clearSavedChanges();
    }

    checkAuthState();
    syncDraftsWithDOM();
  }

  initAdminToolbar();
  document.addEventListener("astro:after-swap", initAdminToolbar);
</script>
