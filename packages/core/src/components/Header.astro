---
interface Props {
  title: string;
  institution?: string;
  logoUrl?: string;
  navItems?: Array<{ label: string; href: string }>;
  currentPath?: string;
}

const {
  title,
  institution = "RÉPUBLIQUE DU MALI",
  logoUrl = "/images/logo-mali.svg",
  navItems = [
    { label: "Accueil", href: "/" },
    { label: "Démarches & Services", href: "/services" },
    { label: "Formulaires", href: "/formulaires" },
    { label: "Actualités", href: "/actualites" },
    { label: "FAQ", href: "/faq" },
    { label: "Thèmes & Couleurs", href: "/themes" },
    { label: "Contact", href: "/contact" },
  ],
  currentPath = "/",
} = Astro.props;
---

<header
  class="ml-header ml-header-sticky"
  id="site-header"
>
  <div class="ml-container">
    <div class="header-top">
      <a href="/" class="brand-block">
        <img
          src={logoUrl}
          alt="Armoiries de la République du Mali"
          class="ml-header-logo"
          width="58"
          height="58"
        />
        <div class="brand-text">
          <div class="brand-title" data-cms-bind="siteConfig.institution">
            {institution}
          </div>
          <div class="site-title" data-cms-bind="siteConfig.title">{title}</div>
          <div class="ml-tricolor-bar" aria-hidden="true">
            <div class="green"></div>
            <div class="yellow"></div>
            <div class="red"></div>
          </div>
        </div>
      </a>

      <div class="header-actions">
        <a
          href="/login"
          id="header-auth-login"
          class="header-auth-btn items-center gap-1.5"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span>Se connecter</span>
        </a>
        <button
          type="button"
          id="header-auth-logout"
          class="header-auth-btn header-auth-logout items-center gap-1.5 hidden"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>Déconnexion</span>
        </button>

        <button
          type="button"
          class="ml-header-burger"
          id="header-burger"
          aria-label="Menu principal"
          aria-expanded="false"
          aria-controls="header-nav"
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            width="24"
            height="24"
          >
            <path
              d="M4 6h16M4 12h16M4 18h16"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </button>
      </div>
    </div>

    <nav class="ml-header-nav" id="header-nav" aria-label="Menu principal">
      <div class="ml-header-nav-header">
        <span class="font-bold text-sm text-[var(--ml-color-neutral-800)]"
          >Navigation</span
        >
        <button
          type="button"
          class="ml-header-nav-close text-xl font-bold"
          id="header-nav-close"
          aria-label="Fermer le menu">&times;</button
        >
      </div>

      <div class="ml-header-utility-nav">
        <a href="/login" id="mobile-auth-login" class="ml-utility-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          <span>Se connecter</span>
        </a>
        <button type="button" id="mobile-auth-logout" class="ml-utility-item hidden">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          <span>Déconnexion</span>
        </button>
      </div>
      <div class="ml-utility-divider"></div>

      {
        navItems.map((item) => {
          const isActive =
            currentPath === item.href ||
            (item.href !== "/" && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`ml-nav-item ${isActive ? "active" : ""}`}
              aria-current={isActive ? "page" : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>

<style>
  .header-auth-btn {
    padding: 0.375rem 0.875rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 0.8125rem;
    color: var(--ml-color-river-700, #0284c7);
    border: 1px solid var(--ml-color-river-200, #bae6fd);
    background-color: var(--ml-color-river-50, #f0f9ff);
    transition: all 0.15s ease;
    text-decoration: none;
    display: inline-flex;
  }
  .header-auth-btn:hover {
    background-color: var(--ml-color-river-700, #0284c7);
    color: #ffffff;
    border-color: var(--ml-color-river-700, #0284c7);
  }
  .header-auth-logout {
    color: #dc2626;
    border-color: #fecaca;
    background-color: #fef2f2;
    cursor: pointer;
  }
  .header-auth-logout:hover {
    background-color: #dc2626;
    color: #ffffff;
    border-color: #dc2626;
  }

  @media (max-width: 860px) {
    .header-auth-btn {
      display: none !important;
    }
  }

  @media (min-width: 861px) {
    .ml-header-utility-nav,
    .ml-utility-divider {
      display: none !important;
    }
  }

  .hidden {
    display: none !important;
  }
</style>

<script>
  import { getAdminCookieToken, clearAdminCookieToken } from '../utils/auth.js';

  function setupHeaderBurger() {
    const burgerBtn = document.getElementById("header-burger");
    const closeBtn = document.getElementById("header-nav-close");
    const navMenu = document.getElementById("header-nav");

    if (!burgerBtn || !navMenu) return;

    function toggleMenu(e: Event) {
      e.stopPropagation();
      const isOpen = navMenu.classList.toggle("is-open");
      burgerBtn.setAttribute("aria-expanded", String(isOpen));
    }

    burgerBtn.addEventListener("click", toggleMenu);

    if (closeBtn) {
      closeBtn.addEventListener("click", toggleMenu);
    }
  }

  function updateHeaderAuth() {
    const token = getAdminCookieToken();
    const isLoggedIn = !!token && token.length > 0;

    const desktopLogin = document.getElementById("header-auth-login");
    const desktopLogout = document.getElementById("header-auth-logout");
    const mobileLogin = document.getElementById("mobile-auth-login");
    const mobileLogout = document.getElementById("mobile-auth-logout");

    if (isLoggedIn) {
      desktopLogin?.classList.add("hidden");
      desktopLogout?.classList.remove("hidden");
      mobileLogin?.classList.add("hidden");
      mobileLogout?.classList.remove("hidden");
    } else {
      desktopLogin?.classList.remove("hidden");
      desktopLogout?.classList.add("hidden");
      mobileLogin?.classList.remove("hidden");
      mobileLogout?.classList.add("hidden");
    }
  }

  function setupAuthEvents() {
    const desktopLogout = document.getElementById("header-auth-logout");
    const mobileLogout = document.getElementById("mobile-auth-logout");

    function handleLogout() {
      clearAdminCookieToken();
      updateHeaderAuth();
      if (window.location.pathname === "/admin") {
        window.location.href = "/";
      } else {
        window.location.reload();
      }
    }

    desktopLogout?.addEventListener("click", handleLogout);
    mobileLogout?.addEventListener("click", handleLogout);
  }

  setupHeaderBurger();
  updateHeaderAuth();
  setupAuthEvents();

  document.addEventListener("astro:after-swap", () => {
    setupHeaderBurger();
    updateHeaderAuth();
    setupAuthEvents();
  });
</script>
